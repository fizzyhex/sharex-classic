                        <Path Data="M 112,34 C 109.52,30.46 110.66,25.09 114.19,23.69 C 116.85,26.41 115.71,31.77 112,34 Z M 112,34 C 114.6,30.55 120.06,29.97 122.48,32.9 C 120.72,36.26 115.27,36.84 112,34 Z M 112,34 C 116.09,35.41 118.32,40.42 116.29,43.63 C 112.54,42.99 110.31,37.98 112,34 Z M 112,34 C 111.92,38.32 107.85,41.99 104.17,41.05 C 103.62,37.29 107.69,33.62 112,34 Z M 112,34 C 107.86,35.26 103.12,32.52 102.87,28.73 C 106.28,27.05 111.03,29.79 112,34 Z" Fill="{DynamicResource Aero.Art.Petal.Gloss}"/>
