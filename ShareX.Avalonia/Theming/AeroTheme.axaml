                            <Path Data="M 330,-20 L -40,120 L -40,165 Z" Fill="{DynamicResource Aero.Art.Ray}" Opacity="0.7"/>
                        </Canvas>
                        <Path Data="M 0,0 H 340 V 150 C 250,185 130,205 0,222 Z" Fill="{DynamicResource Aero.Art.Gloss}"/>
                        <!-- A flowering sprig hanging from the top left corner. -->
