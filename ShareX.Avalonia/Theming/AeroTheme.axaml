                    </Canvas>
                    <!-- Drifting bokeh and bubbles (they only move while the window is active). -->
                    <Canvas Name="AeroBannerDrift" Width="340" Height="400" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <!-- When the window goes inactive the drift pauses; the bokeh glides back instead of jumping. -->
                        <Canvas.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:1.2" Easing="SineEaseInOut"/>
                            </Transitions>
                        </Canvas.Transitions>
                        <Ellipse Canvas.Left="262" Canvas.Top="150" Width="34" Height="34" Fill="{DynamicResource Aero.Art.Bokeh}"/>
                        <Ellipse Canvas.Left="196" Canvas.Top="206" Width="16" Height="16" Fill="{DynamicResource Aero.Art.Bubble}"/>
                        <Ellipse Canvas.Left="200" Canvas.Top="208" Width="5" Height="4" Fill="{DynamicResource Aero.Art.Bubble.Spot}"/>
                        <Ellipse Canvas.Left="96" Canvas.Top="282" Width="22" Height="22" Fill="{DynamicResource Aero.Art.Bokeh}"/>
                        <Ellipse Canvas.Left="306" Canvas.Top="232" Width="12" Height="12" Fill="{DynamicResource Aero.Art.Bubble}"/>
                        <Ellipse Canvas.Left="58" Canvas.Top="300" Width="12" Height="12" Fill="{DynamicResource Aero.Art.Bokeh}"/>
                        <Path Data="M 196,214 C 200.71,212.56 206.11,215.68 206.39,220 C 202.51,221.92 197.11,218.8 196,214 Z" Fill="{DynamicResource Aero.Art.Petal}" Stroke="{DynamicResource Aero.Art.Petal.Edge}" StrokeThickness="0.6"/>
                        <Path Data="M 150,300 C 151.86,303.66 150.08,308.54 146.58,309.4 C 144.44,306.49 146.22,301.61 150,300 Z" Fill="{DynamicResource Aero.Art.Petal}" Stroke="{DynamicResource Aero.Art.Petal.Edge}" StrokeThickness="0.6"/>
                        <Path Data="M 282,150 C 282.83,146.4 286.89,144.06 289.79,145.5 C 289.59,148.74 285.53,151.08 282,150 Z" Fill="{DynamicResource Aero.Art.Petal}" Stroke="{DynamicResource Aero.Art.Petal.Edge}" StrokeThickness="0.6"/>
                    </Canvas>
                    <!-- The glass edge against the content. -->
                    <Border Width="1" HorizontalAlignment="Right" Background="#50FFFFFF"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Ambient life, only while the window is active on glass: the bokeh drifts and the rays breathe. -->
    <Style Selector=":is(Window).aero-glass.aero-active ContentControl.aero-banner-art /template/ Canvas#AeroBannerDrift">
        <Style.Animations>
            <Animation Duration="0:0:14" IterationCount="Infinite" PlaybackDirection="Alternate">
                <Animation.Easing>
                    <theming:AeroStepEasing Steps="56"/>
                </Animation.Easing>
                <KeyFrame Cue="0%">
                    <Setter Property="RenderTransform" Value="translate(0px, 0px)"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RenderTransform" Value="translate(8px, -26px)"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector=":is(Window).aero-glass.aero-active ContentControl.aero-banner-art /template/ Canvas#AeroBannerRays">
        <Style.Animations>
            <Animation Duration="0:0:9" IterationCount="Infinite" PlaybackDirection="Alternate">
                <Animation.Easing>
                    <theming:AeroStepEasing Steps="20"/>
                </Animation.Easing>
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.85"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.45"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- The flowers bloom in once, when the window opens. -->
    <Style Selector="ContentControl.aero-banner-art /template/ Canvas#AeroBannerFlora">
        <Style.Animations>
            <Animation Duration="0:0:0.9" Delay="0:0:0.15" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="14"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ContentControl.aero-banner-art /template/ Canvas#AeroBannerSprig">
        <Style.Animations>
            <Animation Duration="0:0:0.9" Delay="0:0:0.35" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="-10"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="controls|SettingsNavigation TreeView /template/ Canvas#AeroSprig">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- The backdrop of the empty main window, behind the hotkey gadget. Static. -->
    <Style Selector="ContentControl.aero-backdrop-art">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{DynamicResource Aero.Art.Backdrop}"/>
                    <Border Background="{DynamicResource Aero.Art.Backdrop.Glow}"/>
                    <Viewbox Height="230" VerticalAlignment="Bottom" Stretch="Fill">
                        <Canvas Width="900" Height="230">
                            <Path Data="M -20,200 C 200,150 480,190 920,40 L 920,70 C 500,214 210,180 -20,232 Z" Fill="{DynamicResource Aero.Art.Backdrop.Ribbon}"/>
                            <Path Data="M -20,214 C 260,160 520,196 920,78 L 920,84 C 520,206 260,172 -20,222 Z" Fill="{DynamicResource Aero.Art.Backdrop.Ribbon.Light}"/>
                            <Path Data="M -20,160 C 220,130 420,150 920,10 L 920,18 C 430,162 220,142 -20,168 Z" Fill="{DynamicResource Aero.Art.Backdrop.Ribbon}" Opacity="0.6"/>
                        </Canvas>
