                        <Path Data="M 70,118 C 69.5,113.93 72.84,109.94 76.43,110.34 C 77.44,113.8 74.1,117.78 70,118 Z M 70,118 C 73.72,116.27 78.54,118.22 79.27,121.75 C 76.29,123.78 71.47,121.83 70,118 Z M 70,118 C 72.8,121 72.43,126.19 69.3,127.98 C 66.45,125.77 66.81,120.58 70,118 Z M 70,118 C 68.01,121.59 62.96,122.85 60.3,120.42 C 61.51,117.02 66.56,115.77 70,118 Z M 70,118 C 65.97,117.22 63.22,112.81 64.7,109.52 C 68.3,109.63 71.06,114.04 70,118 Z" Fill="{DynamicResource Aero.Art.Petal}" Stroke="{DynamicResource Aero.Art.Petal.Edge}" StrokeThickness="0.8" Opacity="0.9"/>
                        <Path Data="M 70,118 C 69.69,115.47 71.76,113 73.99,113.25 C 74.61,115.4 72.54,117.87 70,118 Z M 70,118 C 72.31,116.93 75.3,118.13 75.75,120.32 C 73.9,121.58 70.91,120.37 70,118 Z M 70,118 C 71.73,119.86 71.51,123.08 69.57,124.18 C 67.8,122.82 68.02,119.6 70,118 Z M 70,118 C 68.77,120.22 65.64,121 63.98,119.5 C 64.74,117.4 67.87,116.62 70,118 Z M 70,118 C 67.5,117.51 65.79,114.78 66.71,112.74 C 68.95,112.81 70.66,115.54 70,118 Z" Fill="{DynamicResource Aero.Art.Petal.Gloss}" Opacity="0.9"/>
                        <Ellipse Canvas.Left="68" Canvas.Top="116" Width="4" Height="4" Fill="{DynamicResource Aero.Art.Petal.Core}" Opacity="0.9"/>
                        <Path Data="M 72.91,117.27 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0 M 71.59,120.54 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0 M 68.07,120.3 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0 M 67.22,116.88 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0 M 70.21,115.01 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0" Fill="{DynamicResource Aero.Art.Sparkle}" Opacity="0.9"/>
                        <Ellipse Canvas.Left="68.84" Canvas.Top="79.21" Width="6" Height="6" Fill="{DynamicResource Aero.Art.Bubble}"/>
                        <Ellipse Canvas.Left="70.19" Canvas.Top="80.41" Width="2.1" Height="1.5" Fill="{DynamicResource Aero.Art.Bubble.Spot}"/>
                        </Canvas>
                        <Path Canvas.Left="286" Canvas.Top="44" Data="M 0,-7 L 1.4,-1.4 L 7,0 L 1.4,1.4 L 0,7 L -1.4,1.4 L -7,0 L -1.4,-1.4 Z" Fill="{DynamicResource Aero.Art.Sparkle}"/>
                        <Path Canvas.Left="250" Canvas.Top="92" Data="M 0,-4 L 0.8,-0.8 L 4,0 L 0.8,0.8 L 0,4 L -0.8,0.8 L -4,0 L -0.8,-0.8 Z" Fill="{DynamicResource Aero.Art.Sparkle}" Opacity="0.8"/>
                    </Canvas>
