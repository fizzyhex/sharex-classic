                        <Path Data="M 214,312 C 211.39,306.88 213.88,300.04 218.79,298.84 C 221.78,302.91 219.29,309.75 214,312 Z M 214,312 C 218.06,307.94 225.34,308.19 227.99,312.49 C 225.05,316.59 217.77,316.33 214,312 Z M 214,312 C 219.12,314.61 221.12,321.61 217.86,325.46 C 213.05,323.92 211.04,316.93 214,312 Z M 214,312 C 213.1,317.67 207.06,321.74 202.39,319.83 C 202.37,314.78 208.4,310.71 214,312 Z M 214,312 C 208.33,312.9 202.59,308.41 202.97,303.38 C 207.76,301.79 213.5,306.28 214,312 Z" Fill="{DynamicResource Aero.Art.Petal}" Stroke="{DynamicResource Aero.Art.Petal.Edge}" StrokeThickness="0.8" Opacity="0.95"/>
                        <Path Data="M 214,312 C 212.38,308.83 213.93,304.58 216.97,303.84 C 218.82,306.37 217.28,310.61 214,312 Z M 214,312 C 216.52,309.48 221.03,309.64 222.67,312.3 C 220.85,314.84 216.34,314.69 214,312 Z M 214,312 C 217.17,313.62 218.42,317.96 216.39,320.34 C 213.41,319.39 212.17,315.05 214,312 Z M 214,312 C 213.44,315.52 209.7,318.04 206.8,316.85 C 206.79,313.72 210.53,311.2 214,312 Z M 214,312 C 210.48,312.56 206.92,309.78 207.16,306.66 C 210.13,305.67 213.69,308.45 214,312 Z" Fill="{DynamicResource Aero.Art.Petal.Gloss}" Opacity="0.95"/>
