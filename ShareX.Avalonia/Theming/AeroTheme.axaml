                        <Path Data="M 22.92,16.66 C 22.35,5.74 31.21,-3.24 42.7,-3.19 C 40.31,7.41 32.07,15.82 22.92,16.66 Z" Fill="{DynamicResource Aero.Art.Leaf.Deep}" Stroke="{DynamicResource Aero.Art.Leaf.Edge}" StrokeThickness="0.8"/>
