<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Controls.Converters"
        xmlns:controls="using:ShareX.AvaloniaUI.Controls"
        xmlns:theming="using:ShareX.AvaloniaUI.Theming"
        xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        xmlns:cpp="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls.ColorPicker">
    <!--
        Aero theme: Windows 7 Aero (and Aero Basic). The control chrome follows WPF's PresentationFramework.Aero:
        glossy two-tone faces with a hard split, a white inner highlight, and hover/pressed looks drawn as separate
        layers whose Opacity fades in and out (the only properties animated are Opacity and RenderTransform).

        ThemeManager adds this file to the application styles and appends it to every window's styles while an Aero
        theme is active, exactly like ClassicTheme.axaml, so it wins over the Fluent restyling in the windows. Template
        parts that controls require keep their PART_ names; every other part has an "Aero" name.

        Windows with a standard frame get the "aero-frame" class from AeroWindowFrame: their client area is extended
        into the title bar and AeroWindowDecorations draws the glass frame, caption and caption buttons around it.
    -->

    <Styles.Resources>
        <x:Double x:Key="Aero.ScrollBarSize">17</x:Double>
        <x:Double x:Key="Aero.ControlHeight">23</x:Double>
        <x:Double x:Key="TreeViewItemIndent">16</x:Double>

        <!-- Windows 7 layout is denser than the Fluent layout. These become the default spacing that ThemeManager
             blends with CompactMode.axaml, so the spacing sliders keep working. -->
        <x:Double x:Key="ShareX.Density.Nav.ButtonHeight">25</x:Double>
        <Thickness x:Key="ShareX.Density.Nav.ButtonPadding">4,1</Thickness>
        <x:Double x:Key="ShareX.Density.Menu.ItemHeight">22</x:Double>
        <Thickness x:Key="ShareX.Density.Menu.Padding">2</Thickness>
        <Thickness x:Key="ShareX.Density.Menu.ItemPadding">2,0</Thickness>
        <Thickness x:Key="ShareX.Density.Menu.SeparatorMargin">0</Thickness>
        <Thickness x:Key="MenuFlyoutPresenterThemePadding">2</Thickness>
        <x:Double x:Key="ShareX.Density.Settings.CheckBoxMinHeight">21</x:Double>
        <x:Double x:Key="ShareX.Density.Settings.ControlMinHeight">23</x:Double>
        <Thickness x:Key="ShareX.Density.Settings.ControlPadding">4,1</Thickness>
        <x:Double x:Key="ShareX.Density.Settings.NumberBoxHeight">23</x:Double>
        <Thickness x:Key="ShareX.Density.Settings.ButtonPadding">10,1</Thickness>
        <x:Double x:Key="ShareX.Density.Settings.NavItemMinHeight">22</x:Double>
        <Thickness x:Key="ShareX.Density.Settings.NavItemMargin">2,1</Thickness>
        <Thickness x:Key="ShareX.Density.Settings.SearchPadding">26,3,3,3</Thickness>

        <conv:PlatformKeyGestureConverter x:Key="AeroKeyGestureConverter"/>

        <!-- Reflection streaks of the glass: soft diagonal white bands anchored to the top left of the window. -->
        <LinearGradientBrush x:Key="AeroGlassStreaks" StartPoint="0,0" EndPoint="560,300">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.13"/>
            <GradientStop Color="#2EFFFFFF" Offset="0.17"/>
            <GradientStop Color="#10FFFFFF" Offset="0.21"/>
            <GradientStop Color="#00FFFFFF" Offset="0.25"/>
            <GradientStop Color="#00FFFFFF" Offset="0.36"/>
            <GradientStop Color="#22FFFFFF" Offset="0.40"/>
            <GradientStop Color="#22FFFFFF" Offset="0.43"/>
            <GradientStop Color="#00FFFFFF" Offset="0.49"/>
            <GradientStop Color="#00FFFFFF" Offset="0.66"/>
            <GradientStop Color="#18FFFFFF" Offset="0.69"/>
            <GradientStop Color="#00FFFFFF" Offset="0.75"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroGlassHaze" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#50FFFFFF" Offset="0"/>
            <GradientStop Color="#18FFFFFF" Offset="0.6"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroCaptionGloss" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#A0FFFFFF" Offset="0"/>
            <GradientStop Color="#40FFFFFF" Offset="0.45"/>
            <GradientStop Color="#00FFFFFF" Offset="0.46"/>
            <GradientStop Color="#00FFFFFF" Offset="0.75"/>
            <GradientStop Color="#28FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <!-- The light that sweeps once across a glossy surface after the pointer has rested on it for two seconds. -->
        <LinearGradientBrush x:Key="AeroSheen" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#58FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroProgressGlint" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#60FFFFFF" Offset="0.4"/>
            <GradientStop Color="#60FFFFFF" Offset="0.6"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroProgressHighlight" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#A0FFFFFF" Offset="0"/>
            <GradientStop Color="#70FFFFFF" Offset="0.25"/>
            <GradientStop Color="#60FFFFFF" Offset="0.5385"/>
            <GradientStop Color="#00FFFFFF" Offset="0.5385"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroProgressTrackGloss" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#90FFFFFF" Offset="0"/>
            <GradientStop Color="#50FFFFFF" Offset="0.5385"/>
            <GradientStop Color="#00FFFFFF" Offset="0.5385"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroProgressGlow" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#00FFFFC4" Offset="0.55"/>
            <GradientStop Color="#60FFFFC4" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroProgressEdgeLeft" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#28000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroProgressEdgeRight" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#28000000" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AeroProgressMarquee" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#0001D328" Offset="0"/>
            <GradientStop Color="#FF01D328" Offset="0.35"/>
            <GradientStop Color="#FF01D328" Offset="0.65"/>
            <GradientStop Color="#0001D328" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================================================================== -->
        <!-- Window frame: glass (or the opaque Aero Basic frame), glowing caption text and caption buttons. -->
        <!-- ============================================================================================== -->
        <!--
            Caption buttons: transparent at rest with thin glyphs, like Windows 11; the Aero glass highlight, gloss and glow
            fade in while the pointer is over them.
        -->
        <ControlTheme x:Key="AeroCaptionButton" TargetType="theming:AeroCaptionButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Aero.Caption.Text}"/>
            <Setter Property="Tag" Value="{DynamicResource Aero.Caption.Button.Glow}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="AeroCapGlow"
                                Margin="-12,-5,-12,-12"
                                Background="{TemplateBinding Tag}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroCapFace"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border Name="AeroCapHot"
                                Background="{DynamicResource Aero.Caption.Button.Hot}"
                                BorderBrush="{DynamicResource Aero.Caption.Button.Border.Hot}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroCapPressed"
                                Background="{DynamicResource Aero.Caption.Button.Pressed}"
                                BorderBrush="{DynamicResource Aero.Caption.Button.Border.Hot}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroCapGloss"
                                Margin="1"
                                Background="{StaticResource AeroCaptionGloss}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroCapInner"
                                Margin="1"
                                BorderBrush="#60FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroCapHot, ^:pointerover /template/ Border#AeroCapGloss, ^:pointerover /template/ Border#AeroCapInner">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#AeroCapGlow">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroCapPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroCapGlow">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>
        </ControlTheme>

        <!-- The close button is glossy red and glows red beyond its edges while hot. -->
        <ControlTheme x:Key="AeroCaptionCloseButton" TargetType="theming:AeroCaptionButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Aero.Caption.Text}"/>
            <Setter Property="Tag" Value="{DynamicResource Aero.CaptionClose.Glow}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="AeroCapFace"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border Name="AeroCapHot"
                                Background="{DynamicResource Aero.CaptionClose.Hot}"
                                BorderBrush="{DynamicResource Aero.CaptionClose.Border}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroCapPressed"
                                Background="{DynamicResource Aero.CaptionClose.Pressed}"
                                BorderBrush="{DynamicResource Aero.CaptionClose.Border}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroCapGloss"
                                Margin="1"
                                Background="{StaticResource AeroCaptionGloss}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroCapInner"
                                Margin="1"
                                BorderBrush="#60FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroCapHot, ^:pointerover /template/ Border#AeroCapGloss, ^:pointerover /template/ Border#AeroCapInner">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#AeroCapGlow">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroCapPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroCapGlow">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>
            <Style Selector="^:pointerover, ^:pressed">
                <Setter Property="Foreground" Value="White"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroWindowDecorations" TargetType="WindowDrawnDecorations">
            <Setter Property="DefaultTitleBarHeight" Value="30"/>
            <Setter Property="DefaultFrameThickness" Value="0"/>
            <Setter Property="DefaultShadowThickness" Value="0"/>
            <Setter Property="Template">
                <WindowDrawnDecorationsTemplate>
                    <WindowDrawnDecorationsContent>
                        <WindowDrawnDecorationsContent.Underlay>
                            <Panel x:Name="PART_UnderlayWrapper">
                                <!-- Glass: the accent tint over the blurred backdrop (or the opaque Aero Basic frame). -->
                                <Panel x:Name="AeroGlassLayer">
                                    <Border x:Name="AeroGlassActive" Background="{DynamicResource Aero.Glass.Active}">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Border.Transitions>
                                    </Border>
                                    <Border x:Name="AeroGlassInactive" Background="{DynamicResource Aero.Glass.Inactive}" Opacity="0">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Border.Transitions>
                                    </Border>
                                    <Border x:Name="AeroGlassHaze"
                                            VerticalAlignment="Top"
                                            Height="64"
                                            Background="{StaticResource AeroGlassHaze}"/>
                                    <Border x:Name="AeroGlassStreaks" Background="{StaticResource AeroGlassStreaks}"/>
                                </Panel>
                                <Panel x:Name="AeroBasicLayer" IsVisible="False">
                                    <Border x:Name="AeroBasicActive" Background="{DynamicResource Aero.Glass.Basic.Active}"/>
                                    <Border x:Name="AeroBasicInactive" Background="{DynamicResource Aero.Glass.Basic.Inactive}" IsVisible="False"/>
                                </Panel>
                                <!-- The bright inner edge of the frame and the dark edge around the client area. -->
                                <Border x:Name="AeroFrameHighlight"
                                        BorderBrush="{DynamicResource Aero.Glass.Highlight}"
                                        BorderThickness="1"
                                        CornerRadius="4,4,0,0"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="AeroClientEdge"
                                        Margin="6,29,6,6"
                                        BorderBrush="{DynamicResource Aero.ClientEdge}"
                                        BorderThickness="1"
                                        IsHitTestVisible="False"/>
                                <!-- The red glow around the hot close button spills over the glass. -->
                                <Border x:Name="AeroCloseGlow"
                                        Width="70"
                                        Height="40"
                                        Margin="0,-6,-12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Aero.CaptionClose.Glow}"
                                        IsHitTestVisible="False"
                                        Opacity="{Binding #PART_CloseButton.IsPointerOver, Converter={x:Static theming:BoolToOpacityConverter.Instance}}">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                            </Panel>
                        </WindowDrawnDecorationsContent.Underlay>

                        <WindowDrawnDecorationsContent.Overlay>
                            <Panel x:Name="PART_OverlayWrapper">
                                <!-- Drag and resize areas sit above the window, which covers the underlay. The window content
                                     is inset by the frame, so they never cover controls. -->
                                <Panel x:Name="PART_TitleBar"
                                       VerticalAlignment="Top"
                                       Height="{TemplateBinding TitleBarHeight}"
                                       Background="Transparent"
                                       IsVisible="{TemplateBinding HasTitleBar}"
                                       WindowDecorationProperties.ElementRole="TitleBar"/>
                                <!-- The glass frame is part of the resize border, like the Windows 7 frame. -->
                                <Panel x:Name="AeroResizeGrips">
                                    <Border Width="7" HorizontalAlignment="Left" Margin="0,8" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeW"/>
                                    <Border Width="7" HorizontalAlignment="Right" Margin="0,8" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeE"/>
                                    <Border Height="7" VerticalAlignment="Bottom" Margin="8,0" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeS"/>
                                    <Border Height="4" VerticalAlignment="Top" Margin="8,0" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeN"/>
                                    <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeSW"/>
                                    <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeSE"/>
                                    <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeNW"/>
                                    <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeNE"/>
                                </Panel>
                                <!-- The title shares the height of the caption buttons, so both are centred on the visible caption; the
                                     reported title bar height can be taller than the glass above the client area. -->
                                <StackPanel x:Name="AeroTitlePanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top"
                                            Height="29"
                                            Margin="8,0,150,0"
                                            Spacing="5"
                                            IsHitTestVisible="False"
                                            IsVisible="{TemplateBinding HasTitleBar}">
                                    <Image x:Name="AeroCaptionIcon" Width="16" Height="16" VerticalAlignment="Center" ZIndex="1"/>
                                    <Panel VerticalAlignment="Center">
                                        <!-- A diffused rounded bar behind the title: full strength to 8 px past the text, then a 14 px fade, as Windows 7 draws it. -->
                                        <Grid x:Name="AeroTitleGlow" Margin="-22,-7" ColumnDefinitions="14,*,14">
                                            <Border Background="{DynamicResource Aero.Caption.TextGlow.Start}"/>
                                            <Border Grid.Column="1" Background="{DynamicResource Aero.Caption.TextGlow.Middle}"/>
                                            <Border Grid.Column="2" Background="{DynamicResource Aero.Caption.TextGlow.End}"/>
                                        </Grid>
                                        <TextBlock x:Name="AeroTitleText"
                                                   Text="{TemplateBinding Title}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource Aero.Caption.Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Panel>
                                </StackPanel>
                                <!-- Laid out like the Windows 11 caption buttons: flush in the corner, 46 px wide, thin line glyphs. -->
                                <StackPanel x:Name="AeroCaptionButtons"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            IsVisible="{TemplateBinding HasTitleBar}">
                                    <theming:AeroCaptionButton x:Name="PART_MinimizeButton"
                                            Theme="{StaticResource AeroCaptionButton}"
                                            WindowDecorationProperties.ElementRole="MinimizeButton">
                                        <Path Width="10" Height="1" Data="M 0,0.5 H 10" Stroke="{Binding $parent[theming:AeroCaptionButton].Foreground}" StrokeThickness="1"/>
                                    </theming:AeroCaptionButton>
                                    <theming:AeroCaptionButton x:Name="PART_MaximizeButton"
                                            Theme="{StaticResource AeroCaptionButton}"
                                            WindowDecorationProperties.ElementRole="MaximizeButton">
                                        <Path x:Name="AeroMaximizeGlyph" Width="10" Height="10" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{Binding $parent[theming:AeroCaptionButton].Foreground}" StrokeThickness="1"/>
                                    </theming:AeroCaptionButton>
                                    <theming:AeroCaptionButton x:Name="PART_CloseButton"
                                            Theme="{StaticResource AeroCaptionCloseButton}"
                                            WindowDecorationProperties.ElementRole="CloseButton">
                                        <Path Width="10" Height="10" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding $parent[theming:AeroCaptionButton].Foreground}" StrokeThickness="1"/>
                                    </theming:AeroCaptionButton>
                                </StackPanel>
                            </Panel>
                        </WindowDrawnDecorationsContent.Overlay>

                        <WindowDrawnDecorationsContent.FullscreenPopover>
                            <Panel Height="{TemplateBinding DefaultTitleBarHeight}"
                                   VerticalAlignment="Top"
                                   Background="{DynamicResource Aero.Glass.Basic.Active}"
                                   WindowDecorationProperties.ElementRole="DecorationsElement">
                                <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                                <theming:AeroCaptionButton x:Name="PART_PopoverCloseButton"
                                        Theme="{StaticResource AeroCaptionCloseButton}"
                                        HorizontalAlignment="Right"
                                        WindowDecorationProperties.ElementRole="CloseButton">
                                    <Path Width="10" Height="10" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding $parent[theming:AeroCaptionButton].Foreground}" StrokeThickness="1"/>
                                </theming:AeroCaptionButton>
                            </Panel>
                        </WindowDrawnDecorationsContent.FullscreenPopover>
                    </WindowDrawnDecorationsContent>
                </WindowDrawnDecorationsTemplate>
            </Setter>

            <!-- Maximized: the frame is off screen and the caption is shorter, as in Windows 7. -->
            <Style Selector="^:maximized">
                <Setter Property="DefaultTitleBarHeight" Value="22"/>
            </Style>
            <Style Selector="^:maximized /template/ Border#AeroClientEdge">
                <Setter Property="Margin" Value="-1,21,-1,-1"/>
            </Style>
            <Style Selector="^:maximized /template/ Border#AeroFrameHighlight">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^:maximized /template/ Panel#AeroResizeGrips">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^:maximized /template/ Border#AeroCloseGlow">
                <Setter Property="Margin" Value="0,-10,-12,0"/>
            </Style>
            <Style Selector="^:maximized /template/ theming|AeroCaptionButton">
                <Setter Property="Height" Value="21"/>
            </Style>
            <Style Selector="^:maximized /template/ StackPanel#AeroTitlePanel">
                <Setter Property="Margin" Value="4,0,150,0"/>
                <Setter Property="Height" Value="21"/>
            </Style>
            <Style Selector="^:maximized /template/ Path#AeroMaximizeGlyph">
                <Setter Property="Data" Value="M 2.5,2.5 V 0.5 H 9.5 V 7.5 H 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z"/>
            </Style>
            <Style Selector="^:not(:has-maximize) /template/ Panel#AeroResizeGrips">
                <Setter Property="IsVisible" Value="False"/>
            </Style>

            <!-- Caption buttons the window does not allow are hidden. -->
            <Style Selector="^:not(:has-minimize) /template/ theming|AeroCaptionButton#PART_MinimizeButton">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^:not(:has-maximize) /template/ theming|AeroCaptionButton#PART_MaximizeButton">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^ /template/ theming|AeroCaptionButton:disabled">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>

            <!-- Inactive windows: thinner, greyer glass and dimmed caption glyphs, as in Windows 11. -->
            <Style Selector="^.inactive /template/ Border#AeroGlassActive">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="^.inactive /template/ Border#AeroGlassInactive">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^.inactive /template/ StackPanel#AeroCaptionButtons">
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
            <Style Selector="^.inactive /template/ TextBlock#AeroTitleText">
                <Setter Property="Foreground" Value="{DynamicResource Aero.Caption.Text.Inactive}"/>
            </Style>

            <!-- Aero Basic, or glass that is not available: an opaque light blue frame without reflections. -->
            <Style Selector="^.opaque /template/ Panel#AeroGlassLayer">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^.opaque /template/ Panel#AeroBasicLayer">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^.opaque.inactive /template/ Border#AeroBasicInactive">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^.opaque /template/ Grid#AeroTitleGlow">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^.opaque /template/ Border#AeroClientEdge">
                <Setter Property="BorderBrush" Value="{DynamicResource Aero.Glass.Basic.Edge}"/>
            </Style>
        </ControlTheme>

        <!-- ============================================================================================== -->
        <!-- Push button: Button, RepeatButton and ToggleButton (ButtonChrome).                              -->
        <!-- ============================================================================================== -->
        <ControlTheme x:Key="AeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,1"/>
            <Setter Property="MinHeight" Value="{StaticResource Aero.ControlHeight}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <!-- A soft glow around default and primary buttons, outside their edges. -->
                        <Border Name="AeroChromeHalo"
                                Margin="-7"
                                CornerRadius="9"
                                Background="{DynamicResource Aero.Button.Halo}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroChrome"
                                Background="{DynamicResource Aero.Button.Face}"
                                BorderBrush="{DynamicResource Aero.Button.Border}"
                                BorderThickness="1"
                                CornerRadius="3"/>
                        <Border Name="AeroChromeHot"
                                Background="{DynamicResource Aero.Button.Face.Hot}"
                                BorderBrush="{DynamicResource Aero.Button.Border.Hot}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <!-- Light blooming up from the bottom edge while the button is hot. -->
                        <Border Name="AeroChromeBloom"
                                Margin="1"
                                CornerRadius="2"
                                Background="{DynamicResource Aero.Button.Bloom}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroChromePressed"
                                Background="{DynamicResource Aero.Button.Face.Pressed}"
                                BorderBrush="{DynamicResource Aero.Button.Border.Pressed}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                            <Panel Margin="0" ClipToBounds="True">
                                <Border Height="2" VerticalAlignment="Top" CornerRadius="2,2,0,0" Background="{DynamicResource Aero.Button.PressedShadow.Top}"/>
                                <Border Width="2" HorizontalAlignment="Left" CornerRadius="2,0,0,2" Background="{DynamicResource Aero.Button.PressedShadow.Left}"/>
                            </Panel>
                        </Border>
                        <Border Name="AeroChromeInner"
                                Margin="1"
                                BorderBrush="{DynamicResource Aero.Button.InnerBorder}"
                                BorderThickness="1"
                                CornerRadius="2"
                                IsHitTestVisible="False"/>
                        <Border Name="AeroChromeDefault"
                                Margin="1"
                                BorderBrush="{DynamicResource Aero.Button.DefaultRing}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroSheenClip" Margin="1" CornerRadius="2" ClipToBounds="True" IsHitTestVisible="False">
                            <Rectangle Name="AeroSheen" Width="46" HorizontalAlignment="Left" Fill="{StaticResource AeroSheen}" Opacity="0"/>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Rectangle Name="AeroFocusCue"
                                   Margin="3"
                                   Stroke="{DynamicResource Aero.Text}"
                                   StrokeThickness="1"
                                   StrokeDashArray="1,1"
                                   IsHitTestVisible="False"
                                   IsVisible="False"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroChromeHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#AeroChromeBloom">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroChromeBloom">
                <Setter Property="Opacity" Value="0.5"/>
            </Style>
            <!-- A single sweep of light across the face once the pointer has rested on it for two seconds. -->
            <Style Selector="^:pointerover /template/ Rectangle#AeroSheen">
                <Style.Animations>
                    <Animation Duration="0:0:0.8" Delay="0:0:2" Easing="CubicEaseOut">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="TranslateTransform.X" Value="-50"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="TranslateTransform.X" Value="{Binding $parent[Button].Bounds.Width}"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroChromePressed, ^:checked /template/ Border#AeroChromePressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroChromeInner, ^:checked /template/ Border#AeroChromeInner">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource Aero.Button.Text.Disabled}"/>
                <Style Selector="^ /template/ Border#AeroChrome">
                    <Setter Property="Background" Value="{DynamicResource Aero.Button.Face.Disabled}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Aero.Button.Border.Disabled}"/>
                </Style>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroRepeatButton" TargetType="RepeatButton" BasedOn="{StaticResource AeroButton}"/>
        <ControlTheme x:Key="AeroToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource AeroButton}"/>

        <!-- Command bar button: flat until hot, then the button chrome fades in (icon, toolbar, sidebar buttons). -->
        <ControlTheme x:Key="AeroToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Border Name="AeroChromeChecked"
                                Background="{DynamicResource Aero.List.Selected.Background}"
                                BorderBrush="{DynamicResource Aero.List.Selected.Border}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Border Name="AeroChromeHot"
                                Background="{DynamicResource Aero.Button.Face.Hot}"
                                BorderBrush="{DynamicResource Aero.Button.Border.Hot}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                            <Border Margin="0"
                                    BorderBrush="{DynamicResource Aero.Button.InnerBorder}"
                                    BorderThickness="1"
                                    CornerRadius="2"/>
                        </Border>
                        <Border Name="AeroChromePressed"
                                Background="{DynamicResource Aero.Button.Face.Pressed}"
                                BorderBrush="{DynamicResource Aero.Button.Border.Pressed}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroChromeHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroChromePressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^.active /template/ Border#AeroChromeChecked, ^:checked /template/ Border#AeroChromeChecked">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.5"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroToolToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource AeroToolButton}"/>

        <!--
            Navigation item (the main window sidebar): flat until hot, then it lights up like the Windows 7 Start menu,
            a glossy glass highlight with a glow rising from its bottom edge and a sweep of light. The glow comes in
            quickly and fades out slowly.
        -->
        <ControlTheme x:Key="AeroNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Border Name="AeroChromeChecked"
                                Background="{DynamicResource Aero.List.Selected.Background}"
                                BorderBrush="{DynamicResource Aero.List.Selected.Border}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Border Name="AeroNavHot"
                                Background="{DynamicResource Aero.Nav.Hot}"
                                BorderBrush="{DynamicResource Aero.Nav.Hot.Border}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Panel>
                                <Border CornerRadius="2" Background="{DynamicResource Aero.Nav.Hot.Bloom}"/>
                                <Border CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource Aero.Nav.Hot.Inner}"/>
                                <Border CornerRadius="2" ClipToBounds="True">
                                    <Rectangle Name="AeroSheen" Width="60" HorizontalAlignment="Left" Fill="{StaticResource AeroSheen}" Opacity="0"/>
                                </Border>
                            </Panel>
                        </Border>
                        <Border Name="AeroNavPressed"
                                Background="{DynamicResource Aero.Nav.Pressed}"
                                BorderBrush="{DynamicResource Aero.Nav.Pressed.Border}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Border#AeroNavHot">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="SineEaseOut"/>
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:pointerover /template/ Border#AeroNavHot">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:pointerover /template/ Rectangle#AeroSheen">
                <Style.Animations>
                    <Animation Duration="0:0:0.9" Delay="0:0:2" Easing="CubicEaseOut">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="TranslateTransform.X" Value="-60"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="TranslateTransform.X" Value="{Binding $parent[Button].Bounds.Width}"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroNavPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^.active /template/ Border#AeroChromeChecked">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.5"/>
            </Style>
        </ControlTheme>

        <!-- ============================================================================================== -->
        <!-- Check box, radio button, toggle switch (BulletChrome).                                         -->
        <!-- ============================================================================================== -->
        <ControlTheme x:Key="AeroCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="MinHeight" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                        <Panel Width="13" Height="13" VerticalAlignment="Center">
                            <Border Name="AeroBullet"
                                    Background="{DynamicResource Aero.Check.Background}"
                                    BorderBrush="{DynamicResource Aero.Check.Border}"
                                    BorderThickness="1">
                                <Border Name="AeroBulletInner"
                                        Margin="1"
                                        Background="{DynamicResource Aero.Check.InnerFill}"
                                        BorderBrush="{DynamicResource Aero.Check.InnerBorder}"
                                        BorderThickness="1"/>
                            </Border>
                            <Border Name="AeroBulletHot"
                                    Background="{DynamicResource Aero.Check.Background.Hot}"
                                    BorderBrush="{DynamicResource Aero.Check.Border.Hot}"
                                    BorderThickness="1"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Border.Transitions>
                                <Border Margin="1"
                                        Background="{DynamicResource Aero.Check.InnerFill.Hot}"
                                        BorderBrush="{DynamicResource Aero.Check.InnerBorder.Hot}"
                                        BorderThickness="1"/>
                            </Border>
                            <Border Name="AeroBulletPressed"
                                    Background="{DynamicResource Aero.Check.Background.Pressed}"
                                    BorderBrush="{DynamicResource Aero.Check.Border.Pressed}"
                                    BorderThickness="1"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                                    </Transitions>
                                </Border.Transitions>
                                <Border Margin="1"
                                        Background="{DynamicResource Aero.Check.InnerFill.Pressed}"
                                        BorderBrush="{DynamicResource Aero.Check.InnerBorder.Pressed}"
                                        BorderThickness="1"/>
                            </Border>
                            <Path Name="AeroCheckMark"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Data="M 9,1.833 L 10.667,3.167 L 7,10.667 L 5.333,10.667 L 3.333,8.167 L 3.333,6.833 L 4.833,6.5 L 6,8 Z"
                                  Fill="{DynamicResource Aero.Check.Mark}"
                                  IsVisible="False"/>
                            <Border Name="AeroIndeterminateMark"
                                    Width="7"
                                    Height="7"
                                    Background="{DynamicResource Aero.Check.Indeterminate}"
                                    BorderBrush="#40193B55"
                                    BorderThickness="1"
                                    IsVisible="False"/>
                        </Panel>
                        <Panel Grid.Column="1">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True"
                                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <Rectangle Name="AeroFocusCue"
                                       Margin="2,0,0,0"
                                       Stroke="{DynamicResource Aero.Text}"
                                       StrokeThickness="1"
                                       StrokeDashArray="1,1"
                                       IsHitTestVisible="False"
                                       IsVisible="False"/>
                        </Panel>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroBulletHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroBulletPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:checked /template/ Path#AeroCheckMark">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:indeterminate /template/ Border#AeroIndeterminateMark">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:indeterminate:pointerover /template/ Border#AeroIndeterminateMark">
                <Setter Property="Background" Value="{DynamicResource Aero.Check.Indeterminate.Hot}"/>
            </Style>
            <Style Selector="^:focus-visible /template/ Rectangle#AeroFocusCue">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource Aero.GrayText}"/>
                <Style Selector="^ /template/ Border#AeroBullet">
                    <Setter Property="BorderBrush" Value="{DynamicResource Aero.Check.Border.Disabled}"/>
                </Style>
                <Style Selector="^ /template/ Border#AeroBulletInner">
                    <Setter Property="BorderBrush" Value="{DynamicResource Aero.Check.InnerBorder.Disabled}"/>
                    <Setter Property="Background" Value="{DynamicResource Aero.Check.Background}"/>
                </Style>
                <Style Selector="^ /template/ Path#AeroCheckMark">
                    <Setter Property="Fill" Value="{DynamicResource Aero.Check.Mark.Disabled}"/>
                </Style>
                <Style Selector="^ /template/ Border#AeroIndeterminateMark">
                    <Setter Property="Background" Value="{DynamicResource Aero.Check.Indeterminate.Disabled}"/>
                </Style>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="MinHeight" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                        <Panel Width="13" Height="13" VerticalAlignment="Center">
                            <Ellipse Name="AeroRadioOuter"
                                     Fill="{DynamicResource Aero.Check.Background}"
                                     Stroke="{DynamicResource Aero.Check.Border}"
                                     StrokeThickness="1"/>
                            <Ellipse Name="AeroRadioInner"
                                     Margin="2"
                                     Fill="{DynamicResource Aero.Check.InnerFill}"
                                     Stroke="{DynamicResource Aero.Radio.InnerBorder}"
                                     StrokeThickness="1"/>
                            <Panel Name="AeroRadioHot" Opacity="0">
                                <Panel.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Panel.Transitions>
                                <Ellipse Fill="{DynamicResource Aero.Check.Background.Hot}" Stroke="{DynamicResource Aero.Check.Border.Hot}" StrokeThickness="1"/>
                                <Ellipse Margin="2" Fill="{DynamicResource Aero.Check.InnerFill.Hot}" Stroke="{DynamicResource Aero.Radio.InnerBorder.Hot}" StrokeThickness="1"/>
                            </Panel>
                            <Panel Name="AeroRadioPressed" Opacity="0">
                                <Panel.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                                    </Transitions>
                                </Panel.Transitions>
                                <Ellipse Fill="{DynamicResource Aero.Check.Background.Pressed}" Stroke="{DynamicResource Aero.Check.Border.Pressed}" StrokeThickness="1"/>
                                <Ellipse Margin="2" Fill="{DynamicResource Aero.Check.InnerFill.Pressed}" Stroke="{DynamicResource Aero.Radio.InnerBorder.Pressed}" StrokeThickness="1"/>
                            </Panel>
                            <Ellipse Name="AeroRadioDot"
                                     Margin="3"
                                     Fill="{DynamicResource Aero.Radio.Dot}"
                                     Stroke="{DynamicResource Aero.Radio.Dot.Stroke}"
                                     StrokeThickness="1"
                                     IsVisible="False"/>
                        </Panel>
                        <Panel Grid.Column="1">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True"
                                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <Rectangle Name="AeroFocusCue"
                                       Margin="2,0,0,0"
                                       Stroke="{DynamicResource Aero.Text}"
                                       StrokeThickness="1"
                                       StrokeDashArray="1,1"
                                       IsHitTestVisible="False"
                                       IsVisible="False"/>
                        </Panel>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Panel#AeroRadioHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Panel#AeroRadioPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:checked /template/ Ellipse#AeroRadioDot">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:checked:pointerover /template/ Ellipse#AeroRadioDot">
                <Setter Property="Fill" Value="{DynamicResource Aero.Radio.Dot.Hot}"/>
            </Style>
            <Style Selector="^:checked:pressed /template/ Ellipse#AeroRadioDot">
                <Setter Property="Fill" Value="{DynamicResource Aero.Radio.Dot.Pressed}"/>
            </Style>
            <Style Selector="^:focus-visible /template/ Rectangle#AeroFocusCue">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource Aero.GrayText}"/>
                <Style Selector="^ /template/ Ellipse#AeroRadioOuter">
                    <Setter Property="Stroke" Value="{DynamicResource Aero.Check.Border.Disabled}"/>
                </Style>
                <Style Selector="^ /template/ Ellipse#AeroRadioInner">
                    <Setter Property="Fill" Value="{DynamicResource Aero.Check.Background}"/>
                </Style>
                <Style Selector="^ /template/ Ellipse#AeroRadioDot">
                    <Setter Property="Fill" Value="{DynamicResource Aero.Radio.Dot.Disabled}"/>
                    <Setter Property="Stroke" Value="{DynamicResource Aero.Radio.Dot.Stroke.Disabled}"/>
                </Style>
            </Style>
        </ControlTheme>

        <!-- Windows 7 has no toggle switch; every on/off option is a check box. -->
        <ControlTheme x:Key="AeroToggleSwitch" TargetType="ToggleSwitch">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="MinHeight" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                        <Panel Width="13" Height="13" VerticalAlignment="Center">
                            <Border Name="AeroBullet"
                                    Background="{DynamicResource Aero.Check.Background}"
                                    BorderBrush="{DynamicResource Aero.Check.Border}"
                                    BorderThickness="1">
                                <Border Margin="1"
                                        Background="{DynamicResource Aero.Check.InnerFill}"
                                        BorderBrush="{DynamicResource Aero.Check.InnerBorder}"
                                        BorderThickness="1"/>
                            </Border>
                            <Border Name="AeroBulletHot"
                                    Background="{DynamicResource Aero.Check.Background.Hot}"
                                    BorderBrush="{DynamicResource Aero.Check.Border.Hot}"
                                    BorderThickness="1"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Border.Transitions>
                                <Border Margin="1"
                                        Background="{DynamicResource Aero.Check.InnerFill.Hot}"
                                        BorderBrush="{DynamicResource Aero.Check.InnerBorder.Hot}"
                                        BorderThickness="1"/>
                            </Border>
                            <Path Name="AeroCheckMark"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Data="M 9,1.833 L 10.667,3.167 L 7,10.667 L 5.333,10.667 L 3.333,8.167 L 3.333,6.833 L 4.833,6.5 L 6,8 Z"
                                  Fill="{DynamicResource Aero.Check.Mark}"
                                  IsVisible="False"/>
                        </Panel>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True"
                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <!-- ToggleSwitch requires the knob parts. They are empty and zero sized, so a click anywhere toggles the box. -->
                        <Canvas Name="PART_SwitchKnob" Width="0" Height="0">
                            <Grid Name="PART_MovingKnobs" Width="0" Height="0"/>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroBulletHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:checked /template/ Path#AeroCheckMark">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource Aero.GrayText}"/>
                <Style Selector="^ /template/ Border#AeroBullet">
                    <Setter Property="BorderBrush" Value="{DynamicResource Aero.Check.Border.Disabled}"/>
                </Style>
                <Style Selector="^ /template/ Path#AeroCheckMark">
                    <Setter Property="Fill" Value="{DynamicResource Aero.Check.Mark.Disabled}"/>
                </Style>
            </Style>
        </ControlTheme>

        <!-- ============================================================================================== -->
        <!-- Text box (ListBoxChrome): blue borders fade in on hover and focus.                              -->
        <!-- ============================================================================================== -->
        <ControlTheme x:Key="AeroTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Aero.Edit.Background}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Aero.Highlight}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Aero.HighlightText}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource Aero.GrayText}"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="MinHeight" Value="{StaticResource Aero.ControlHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Panel Name="AeroEditChrome">
                            <Border Name="AeroEditBorder"
                                    Background="{DynamicResource Aero.Edit.Background}"
                                    BorderBrush="{DynamicResource Aero.Edit.Border}"
                                    BorderThickness="1"/>
                            <Border Name="AeroEditHot"
                                    BorderBrush="{DynamicResource Aero.Edit.Border.Hot}"
                                    BorderThickness="1"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Border Name="AeroEditFocus"
                                    BorderBrush="{DynamicResource Aero.Edit.Border.Focus}"
                                    BorderThickness="1"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Panel>
                        <Border Name="AeroEditContent" Margin="1" Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ContentPresenter Content="{TemplateBinding InnerLeftContent}"/>
                                <ScrollViewer Name="PART_ScrollViewer"
                                              Grid.Column="1"
                                              AllowAutoHide="False"
                                              BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                              IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Panel VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                        <TextBlock Name="AeroPlaceholder"
                                                   Foreground="{TemplateBinding PlaceholderForeground}"
                                                   FontStyle="Italic"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   Text="{TemplateBinding PlaceholderText}"
                                                   TextAlignment="{TemplateBinding TextAlignment}"
                                                   TextWrapping="{TemplateBinding TextWrapping}">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>
                                        <TextPresenter Name="PART_TextPresenter"
                                                       CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                                       CaretBrush="{TemplateBinding CaretBrush}"
                                                       CaretIndex="{TemplateBinding CaretIndex}"
                                                       LineHeight="{TemplateBinding LineHeight}"
                                                       LetterSpacing="{TemplateBinding LetterSpacing}"
                                                       PasswordChar="{TemplateBinding PasswordChar}"
                                                       RevealPassword="{TemplateBinding RevealPassword}"
                                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                       SelectionStart="{TemplateBinding SelectionStart}"
                                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                                       TextAlignment="{TemplateBinding TextAlignment}"
                                                       TextWrapping="{TemplateBinding TextWrapping}"/>
                                    </Panel>
                                    <ScrollViewer.Styles>
                                        <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Cursor" Value="IBeam"/>
                                        </Style>
                                    </ScrollViewer.Styles>
                                </ScrollViewer>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding InnerRightContent}"/>
                            </Grid>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroEditHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:focus-within /template/ Border#AeroEditFocus">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource Aero.GrayText}"/>
                <Style Selector="^ /template/ Border#AeroEditBorder">
                    <Setter Property="Background" Value="{DynamicResource Aero.Edit.Background.Disabled}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Aero.Edit.Border.Disabled}"/>
                </Style>
            </Style>
        </ControlTheme>

        <!-- Text box hosted by another control (combo box, numeric up-down): the host draws the border. -->
        <ControlTheme x:Key="AeroInnerTextBox" TargetType="TextBox" BasedOn="{StaticResource AeroTextBox}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Style Selector="^ /template/ Panel#AeroEditChrome">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^ /template/ Border#AeroEditContent">
                <Setter Property="Margin" Value="0"/>
            </Style>
        </ControlTheme>

        <!-- ============================================================================================== -->
        <!-- Combo box: a push button with a black arrow (drop-down list), or a text box with a button.      -->
        <!-- ============================================================================================== -->
        <ControlTheme x:Key="AeroComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="MinHeight" Value="{StaticResource Aero.ControlHeight}"/>
            <Setter Property="MaxDropDownHeight" Value="318"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource Aero.GrayText}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <!-- Drop-down list chrome (ButtonChrome) -->
                        <Panel Name="AeroComboButtonChrome">
                            <Border Name="AeroChrome"
                                    Background="{DynamicResource Aero.Button.Face}"
                                    BorderBrush="{DynamicResource Aero.Button.Border}"
                                    BorderThickness="1"
                                    CornerRadius="3"/>
                            <Border Name="AeroChromeHot"
                                    Background="{DynamicResource Aero.Button.Face.Hot}"
                                    BorderBrush="{DynamicResource Aero.Button.Border.Hot}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Border Name="AeroChromePressed"
                                    Background="{DynamicResource Aero.Button.Face.Pressed}"
                                    BorderBrush="{DynamicResource Aero.Button.Border.Pressed}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Border Name="AeroChromeInner"
                                    Margin="1"
                                    BorderBrush="{DynamicResource Aero.Button.InnerBorder}"
                                    BorderThickness="1"
                                    CornerRadius="2"/>
                        </Panel>
                        <!-- Editable chrome (text box border) -->
                        <Panel Name="AeroComboEditChrome" IsVisible="False">
                            <Border Background="{DynamicResource Aero.Edit.Background}"
                                    BorderBrush="{DynamicResource Aero.Edit.Border}"
                                    BorderThickness="1"/>
                            <Border Name="AeroEditHot"
                                    BorderBrush="{DynamicResource Aero.Edit.Border.Hot}"
                                    BorderThickness="1"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Border Name="AeroEditFocus"
                                    BorderBrush="{DynamicResource Aero.Edit.Border.Focus}"
                                    BorderThickness="1"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Panel>
                        <Grid ColumnDefinitions="*,17">
                            <TextBlock Name="PlaceholderTextBlock"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Foreground="{TemplateBinding PlaceholderForeground}"
                                       Text="{TemplateBinding PlaceholderText}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}"/>
                                        <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <ContentControl Name="AeroSelectionBox"
                                            Margin="{TemplateBinding Padding}"
                                            Foreground="{TemplateBinding Foreground}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}"/>
                            <TextBox Name="PART_EditableTextBox"
                                     Classes="aero-inner"
                                     Margin="{TemplateBinding Padding}"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                     Text="{TemplateBinding Text, Mode=TwoWay}"
                                     PlaceholderText="{TemplateBinding PlaceholderText}"
                                     IsVisible="{TemplateBinding IsEditable}"/>
                            <Path Name="AeroDropDownArrow"
                                  Grid.Column="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 3.5,4 L 7,0 Z"
                                  Fill="{DynamicResource Aero.Glyph}"
                                  IsHitTestVisible="False"/>
                            <Popup Name="PART_Popup"
                                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   IsLightDismissEnabled="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   PlacementTarget="{TemplateBinding}"
                                   Placement="BottomEdgeAlignedLeft"
                                   InheritsTransform="True">
                                <Border Name="AeroMenuSurface"
                                        Background="{DynamicResource Aero.DropDown.Background}"
                                        BorderBrush="{DynamicResource Aero.DropDown.Border}"
                                        BorderThickness="1">
                                    <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                  IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                                                  IsScrollChainingEnabled="False">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroChromeHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:dropdownopen /template/ Border#AeroChromePressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:dropdownopen /template/ Border#AeroChromeInner">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="^:focus-visible /template/ Border#AeroChromeInner">
                <Setter Property="BorderBrush" Value="{DynamicResource Aero.Button.DefaultRing}"/>
            </Style>
            <!-- An editable combo box is a text box with a drop-down arrow. -->
            <Style Selector="^[IsEditable=True]">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
                <Style Selector="^ /template/ Panel#AeroComboButtonChrome">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
                <Style Selector="^ /template/ Panel#AeroComboEditChrome">
                    <Setter Property="IsVisible" Value="True"/>
                </Style>
                <Style Selector="^:pointerover /template/ Border#AeroEditHot">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <Style Selector="^:focus-within /template/ Border#AeroEditFocus">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource Aero.Button.Text.Disabled}"/>
                <Style Selector="^ /template/ Border#AeroChrome">
                    <Setter Property="Background" Value="{DynamicResource Aero.Button.Face.Disabled}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Aero.Button.Border.Disabled}"/>
                </Style>
                <Style Selector="^ /template/ Path#AeroDropDownArrow">
                    <Setter Property="Fill" Value="{DynamicResource Aero.Glyph.Disabled}"/>
                </Style>
            </Style>
        </ControlTheme>

        <!-- A button that opens a drop-down (the color picker) is drawn as a drop-down list. -->
        <ControlTheme x:Key="AeroDropDownComboButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="MinHeight" Value="{StaticResource Aero.ControlHeight}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="AeroChrome"
                                Background="{DynamicResource Aero.Button.Face}"
                                BorderBrush="{DynamicResource Aero.Button.Border}"
                                BorderThickness="1"
                                CornerRadius="3"/>
                        <Border Name="AeroChromeHot"
                                Background="{DynamicResource Aero.Button.Face.Hot}"
                                BorderBrush="{DynamicResource Aero.Button.Border.Hot}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroChromePressed"
                                Background="{DynamicResource Aero.Button.Face.Pressed}"
                                BorderBrush="{DynamicResource Aero.Button.Border.Pressed}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroChromeInner"
                                Margin="1"
                                BorderBrush="{DynamicResource Aero.Button.InnerBorder}"
                                BorderThickness="1"
                                CornerRadius="2"/>
                        <Grid ColumnDefinitions="*,17">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <Path Grid.Column="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 3.5,4 L 7,0 Z"
                                  Fill="{DynamicResource Aero.Glyph}"/>
                        </Grid>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroChromeHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroChromePressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroChromeInner">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="^:disabled /template/ Border#AeroChrome">
                <Setter Property="Background" Value="{DynamicResource Aero.Button.Face.Disabled}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Aero.Button.Border.Disabled}"/>
            </Style>
        </ControlTheme>

        <!-- Drop-down items: the hot or selected item is filled with the highlight color, as in Windows 7. -->
        <ControlTheme x:Key="AeroComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      CornerRadius="0"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- List box items: the Explorer selection, a soft rounded blue gradient with black text. -->
        <ControlTheme x:Key="AeroListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="AeroItemHot"
                                Background="{DynamicResource Aero.List.Hot.Background}"
                                BorderBrush="{DynamicResource Aero.List.Hot.Border}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Border.Transitions>
                            <Border BorderBrush="{DynamicResource Aero.List.Gloss}" BorderThickness="1" CornerRadius="2"/>
                        </Border>
                        <Border Name="AeroItemSelected"
                                Background="{DynamicResource Aero.List.Selected.Background}"
                                BorderBrush="{DynamicResource Aero.List.Selected.Border}"
                                BorderThickness="1"
                                CornerRadius="3"
                                IsVisible="False">
                            <Border BorderBrush="{DynamicResource Aero.List.Gloss}" BorderThickness="1" CornerRadius="2"/>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CornerRadius="0"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroItemHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:selected /template/ Border#AeroItemSelected">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:selected:pointerover /template/ Border#AeroItemSelected">
                <Setter Property="Background" Value="{DynamicResource Aero.List.SelectedHot.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Aero.List.SelectedHot.Border}"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroListBox" TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Aero.List.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Aero.List.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="AeroListBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Aero.List.Border}"
                            BorderThickness="1">
                        <ScrollViewer Name="PART_ScrollViewer"
                                      AllowAutoHide="False"
                                      BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                                      HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                      IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                      IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                                      VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                      VerticalSnapPointsType="{TemplateBinding (ScrollViewer.VerticalSnapPointsType)}"
                                      HorizontalSnapPointsType="{TemplateBinding (ScrollViewer.HorizontalSnapPointsType)}">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            Margin="{TemplateBinding Padding}"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Settings navigation tree: Explorer navigation pane rows. -->
        <ControlTheme x:Key="AeroTreeView" TargetType="TreeView">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Aero.Tree.Background}"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Panel>
                            <!-- Shown for the settings navigation only (see the art styles). -->
                            <Canvas Name="AeroSprig"
                                    Width="130"
                                    Height="120"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False">
                                <Path Data="M 134,122 C 100,112 80,92 78,66 C 76,50 88,40 102,46 L 102.63,46.31 L 103.21,46.7 L 103.73,47.14 L 104.2,47.63 L 104.6,48.17 L 104.93,48.75 L 105.18,49.35 L 105.36,49.97 L 105.46,50.6 L 105.49,51.23 L 105.45,51.85 L 105.33,52.46 L 105.15,53.03 L 104.91,53.58 L 104.6,54.08 L 104.24,54.54 L 103.84,54.95 L 103.4,55.31 L 102.93,55.6 L 102.43,55.84 L 101.91,56.01 L 101.39,56.11 L 100.87,56.16 L 100.35,56.14 L 99.85,56.07 L 99.36,55.93 L 98.9,55.75 L 98.48,55.52 L 98.09,55.24 L 97.74,54.92 L 97.44,54.57 L 97.19,54.2 L 96.98,53.8 L 96.83,53.39 L 96.72,52.98 L 96.67,52.56 L 96.67,52.15 L 96.71,51.74 L 96.8,51.36 L 96.94,50.99 L 97.11,50.65 L 97.31,50.34 L 97.55,50.06 L 97.81,49.82 L 98.09,49.61 L 98.38,49.44 L 98.69,49.31 L 99,49.22 L 99.31,49.17 L 99.62,49.15 L 99.92,49.18 L 100.21,49.23 L 100.48,49.32 L 100.73,49.43 L 100.96,49.57 L 101.16,49.73 L 101.34,49.91 L 101.5,50.1 L 101.62,50.3 L 101.72,50.5 L 101.79,50.71 L 101.83,50.92 L 101.85,51.12 L 101.84,51.32 L 101.81,51.5 L 101.77,51.68 L 101.7,51.83 L 101.62,51.98 L 101.53,52.1 L 101.43,52.21 L 101.33,52.3 L 101.22,52.38" Stroke="{DynamicResource Aero.Art.Backdrop.Vine}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"/>
                                <Path Data="M 111.19,112.69 C 108.15,120.73 98.94,124.38 90.69,120.73 C 95.76,113.85 104.34,110.4 111.19,112.69 Z" Fill="{DynamicResource Aero.Art.Backdrop.Leaf}" Stroke="{DynamicResource Aero.Art.Backdrop.Vine}" StrokeThickness="0.8"/>
                                <Path Data="M 84.55,87.67 C 80.87,81.69 83.1,73.89 89.6,70.38 C 91.52,77.1 89.45,84.38 84.55,87.67 Z" Fill="{DynamicResource Aero.Art.Backdrop.Leaf}" Stroke="{DynamicResource Aero.Art.Backdrop.Vine}" StrokeThickness="0.8"/>
                                <Path Data="M 77.81,61.39 C 71.59,61.99 66.24,57.16 65.98,50.6 C 72.09,51.7 77.1,56.19 77.81,61.39 Z" Fill="{DynamicResource Aero.Art.Backdrop.Leaf}" Stroke="{DynamicResource Aero.Art.Backdrop.Vine}" StrokeThickness="0.8"/>
                                <Path Data="M 112,88 C 109.17,83.47 110.92,76.94 115.36,75.44 C 118.46,78.96 116.71,85.49 112,88 Z M 112,88 C 115.43,83.91 122.18,83.56 124.98,87.32 C 122.59,91.35 115.84,91.7 112,88 Z M 112,88 C 116.95,90 119.37,96.31 116.66,100.14 C 112.09,99.11 109.66,92.8 112,88 Z M 112,88 C 111.63,93.32 106.37,97.58 101.9,96.18 C 101.46,91.51 106.72,87.26 112,88 Z M 112,88 C 106.82,89.29 101.15,85.61 101.1,80.92 C 105.4,79.06 111.07,82.75 112,88 Z" Fill="{DynamicResource Aero.Art.Backdrop.Petal}" Stroke="{DynamicResource Aero.Art.Backdrop.Vine}" StrokeThickness="0.8"/>
                                <Path Data="M 112,88 C 110.25,85.19 111.33,81.15 114.09,80.21 C 116,82.4 114.92,86.45 112,88 Z M 112,88 C 114.13,85.47 118.31,85.25 120.05,87.58 C 118.57,90.08 114.38,90.3 112,88 Z M 112,88 C 115.07,89.24 116.57,93.15 114.89,95.52 C 112.05,94.89 110.55,90.97 112,88 Z M 112,88 C 111.77,91.3 108.51,93.94 105.74,93.07 C 105.47,90.18 108.72,87.54 112,88 Z M 112,88 C 108.79,88.8 105.28,86.52 105.24,83.61 C 107.91,82.46 111.42,84.74 112,88 Z" Fill="{DynamicResource Aero.Art.Petal.Gloss}"/>
                                <Ellipse Canvas.Left="109.4" Canvas.Top="85.4" Width="5.2" Height="5.2" Fill="{DynamicResource Aero.Art.Backdrop.Petal}"/>
                                <Path Data="M 115.03,85.55 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0 M 115.27,90.12 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0 M 110.99,91.77 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0 M 108.11,88.2 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0 M 110.6,84.36 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0" Fill="{DynamicResource Aero.Art.Sparkle}"/>
                            </Canvas>
                        <ScrollViewer AllowAutoHide="False"
                                      BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                                      HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                      IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                      IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                                      VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            Margin="{TemplateBinding Padding}"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </ScrollViewer>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Canvas#AeroSprig">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <Panel Name="AeroTreeRow"
                               Background="Transparent"
                               MinHeight="{TemplateBinding MinHeight}"
                               Focusable="True"
                               TemplatedControl.IsTemplateFocusTarget="True">
                            <Border Name="AeroItemHot"
                                    Background="{DynamicResource Aero.List.Hot.Background}"
                                    BorderBrush="{DynamicResource Aero.List.Hot.Border}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Border.Transitions>
                                <Border BorderBrush="{DynamicResource Aero.List.Gloss}" BorderThickness="1" CornerRadius="2"/>
                            </Border>
                            <Border Name="AeroItemSelected"
                                    Background="{DynamicResource Aero.List.Selected.Background}"
                                    BorderBrush="{DynamicResource Aero.List.Selected.Border}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    IsVisible="False">
                                <Border BorderBrush="{DynamicResource Aero.List.Gloss}" BorderThickness="1" CornerRadius="2"/>
                            </Border>
                            <Grid Name="PART_Header" ColumnDefinitions="Auto,*">
                                <Grid.Margin>
                                    <MultiBinding Converter="{x:Static conv:TreeViewItemIndentConverter.Instance}">
                                        <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <DynamicResource ResourceKey="TreeViewItemIndent"/>
                                    </MultiBinding>
                                </Grid.Margin>
                                <!-- The settings tree is always expanded; the toggle part stays for keyboard expand/collapse. -->
                                <ToggleButton Name="PART_ExpandCollapseChevron"
                                              Width="0"
                                              Focusable="False"
                                              IsVisible="False"
                                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"/>
                                <ContentPresenter Name="PART_HeaderPresenter"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  Focusable="False"/>
                            </Grid>
                        </Panel>
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        IsVisible="{TemplateBinding IsExpanded}"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:selected /template/ Border#AeroItemSelected">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
        </ControlTheme>

        <!-- ============================================================================================== -->
        <!-- Scroll bar (ScrollChrome): glossy thumb with a gripper, arrow buttons that light up when hot.   -->
        <!-- ============================================================================================== -->
        <ControlTheme x:Key="AeroScrollBarArrow" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Aero.ScrollBar.Arrow}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Border Name="AeroArrowHot"
                                Margin="0,0,0,1"
                                Background="{DynamicResource Aero.ScrollBar.Thumb.Hot.Horizontal}"
                                BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Border.Hot}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                            <Border BorderBrush="#C0FFFFFF" BorderThickness="1" CornerRadius="1"/>
                        </Border>
                        <Border Name="AeroArrowPressed"
                                Margin="0,0,0,1"
                                Background="{DynamicResource Aero.ScrollBar.Thumb.Pressed.Horizontal}"
                                BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Border.Pressed}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0"/>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource Aero.ScrollBar.Arrow.Hot}"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#AeroArrowHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroArrowPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource Aero.ScrollBar.Arrow.Disabled}"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroScrollBarTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="AeroScrollBarThumbVertical" TargetType="Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Margin="0,1,0,-1" CornerRadius="3" BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Shadow}" BorderThickness="1"/>
                        <Border Background="{DynamicResource Aero.ScrollBar.Thumb.Vertical}"
                                BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Border}"
                                BorderThickness="1"
                                CornerRadius="2"/>
                        <Border Name="AeroThumbHot"
                                Background="{DynamicResource Aero.ScrollBar.Thumb.Hot.Vertical}"
                                BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Border.Hot}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroThumbPressed"
                                Background="{DynamicResource Aero.ScrollBar.Thumb.Pressed.Vertical}"
                                BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Border.Pressed}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0"/>
                        <Border Margin="1" BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Inner}" BorderThickness="1" CornerRadius="1"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                            <Rectangle Classes="aero-grip" Width="7" Height="1"/>
                            <Rectangle Width="7" Height="1" Fill="{DynamicResource Aero.ScrollBar.Grip.Light}"/>
                            <Rectangle Classes="aero-grip" Width="7" Height="1"/>
                            <Rectangle Width="7" Height="1" Fill="{DynamicResource Aero.ScrollBar.Grip.Light}"/>
                            <Rectangle Classes="aero-grip" Width="7" Height="1"/>
                            <Rectangle Width="7" Height="1" Fill="{DynamicResource Aero.ScrollBar.Grip.Light}"/>
                        </StackPanel>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Rectangle.aero-grip">
                <Setter Property="Fill" Value="{DynamicResource Aero.ScrollBar.Grip}"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#AeroThumbHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pointerover /template/ Rectangle.aero-grip">
                <Setter Property="Fill" Value="{DynamicResource Aero.ScrollBar.Grip.Hot}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroThumbPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroScrollBarThumbHorizontal" TargetType="Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Margin="1,0,-1,0" CornerRadius="3" BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Shadow}" BorderThickness="1"/>
                        <Border Background="{DynamicResource Aero.ScrollBar.Thumb.Horizontal}"
                                BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Border}"
                                BorderThickness="1"
                                CornerRadius="2"/>
                        <Border Name="AeroThumbHot"
                                Background="{DynamicResource Aero.ScrollBar.Thumb.Hot.Horizontal}"
                                BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Border.Hot}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroThumbPressed"
                                Background="{DynamicResource Aero.ScrollBar.Thumb.Pressed.Horizontal}"
                                BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Border.Pressed}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0"/>
                        <Border Margin="1" BorderBrush="{DynamicResource Aero.ScrollBar.Thumb.Inner}" BorderThickness="1" CornerRadius="1"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="1">
                            <Rectangle Classes="aero-grip" Width="1" Height="7"/>
                            <Rectangle Width="1" Height="7" Fill="{DynamicResource Aero.ScrollBar.Grip.Light}"/>
                            <Rectangle Classes="aero-grip" Width="1" Height="7"/>
                            <Rectangle Width="1" Height="7" Fill="{DynamicResource Aero.ScrollBar.Grip.Light}"/>
                            <Rectangle Classes="aero-grip" Width="1" Height="7"/>
                            <Rectangle Width="1" Height="7" Fill="{DynamicResource Aero.ScrollBar.Grip.Light}"/>
                        </StackPanel>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Rectangle.aero-grip">
                <Setter Property="Fill" Value="{DynamicResource Aero.ScrollBar.Grip}"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#AeroThumbHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pointerover /template/ Rectangle.aero-grip">
                <Setter Property="Fill" Value="{DynamicResource Aero.ScrollBar.Grip.Hot}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroThumbPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroScrollBar" TargetType="ScrollBar">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="AllowAutoHide" Value="False"/>
            <Style Selector="^:vertical">
                <Setter Property="Width" Value="{StaticResource Aero.ScrollBarSize}"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{DynamicResource Aero.ScrollBar.Track.Vertical}">
                            <Grid RowDefinitions="17,*,17">
                                <RepeatButton Name="PART_LineUpButton" Theme="{StaticResource AeroScrollBarArrow}">
                                    <Path Data="M 0,4 L 3.5,0 L 7,4 Z" Fill="{Binding $parent[RepeatButton].Foreground}"/>
                                </RepeatButton>
                                <Track Grid.Row="1"
                                       IsDirectionReversed="True"
                                       Maximum="{TemplateBinding Maximum}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Orientation="{TemplateBinding Orientation}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}">
                                    <Track.DecreaseButton>
                                        <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource AeroScrollBarTrack}"/>
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource AeroScrollBarTrack}"/>
                                    </Track.IncreaseButton>
                                    <Thumb Name="AeroThumb" MinHeight="17" Margin="1,0,1,1" Theme="{StaticResource AeroScrollBarThumbVertical}"/>
                                </Track>
                                <RepeatButton Name="PART_LineDownButton" Grid.Row="2" Theme="{StaticResource AeroScrollBarArrow}">
                                    <Path Data="M 0,0 L 7,0 L 3.5,4 Z" Fill="{Binding $parent[RepeatButton].Foreground}"/>
                                </RepeatButton>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="^:horizontal">
                <Setter Property="Height" Value="{StaticResource Aero.ScrollBarSize}"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{DynamicResource Aero.ScrollBar.Track.Horizontal}">
                            <Grid ColumnDefinitions="17,*,17">
                                <RepeatButton Name="PART_LineUpButton" Theme="{StaticResource AeroScrollBarArrow}">
                                    <Path Data="M 4,0 L 0,3.5 L 4,7 Z" Fill="{Binding $parent[RepeatButton].Foreground}"/>
                                </RepeatButton>
                                <Track Grid.Column="1"
                                       Maximum="{TemplateBinding Maximum}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Orientation="{TemplateBinding Orientation}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}">
                                    <Track.DecreaseButton>
                                        <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource AeroScrollBarTrack}"/>
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource AeroScrollBarTrack}"/>
                                    </Track.IncreaseButton>
                                    <Thumb Name="AeroThumb" MinWidth="17" Margin="0,1,1,1" Theme="{StaticResource AeroScrollBarThumbHorizontal}"/>
                                </Track>
                                <RepeatButton Name="PART_LineDownButton" Grid.Column="2" Theme="{StaticResource AeroScrollBarArrow}">
                                    <Path Data="M 0,0 L 4,3.5 L 0,7 Z" Fill="{Binding $parent[RepeatButton].Foreground}"/>
                                </RepeatButton>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </Style>
        </ControlTheme>

        <!-- Scroll bars sit beside the content instead of overlaying it. -->
        <ControlTheme x:Key="AeroScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
                        <ScrollContentPresenter Name="PART_ContentPresenter"
                                                Padding="{TemplateBinding Padding}"
                                                HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                                VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                                HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                                VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                                Background="{TemplateBinding Background}"
                                                ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                            <ScrollContentPresenter.GestureRecognizers>
                                <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                                         CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                                         IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}"
                                                         Offset="{Binding Offset, ElementName=PART_ContentPresenter}"
                                                         Viewport="{Binding Viewport, ElementName=PART_ContentPresenter}"
                                                         Extent="{Binding Extent, ElementName=PART_ContentPresenter}"/>
                            </ScrollContentPresenter.GestureRecognizers>
                        </ScrollContentPresenter>
                        <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"/>
                        <ScrollBar Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"/>
                        <Panel Name="AeroScrollCorner" Grid.Row="1" Grid.Column="1" Background="{DynamicResource Aero.Control}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- ============================================================================================== -->
        <!-- Progress bar: green fill under glass, with the moving glint.                                   -->
        <!-- ============================================================================================== -->
        <ControlTheme x:Key="AeroProgressBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Progress.Fill}"/>
            <Setter Property="Background" Value="{DynamicResource Aero.Progress.Track}"/>
            <Setter Property="MinHeight" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Name="AeroProgressTrack"
                                Background="{DynamicResource Aero.Progress.Track}"
                                BorderBrush="{DynamicResource Aero.Progress.Border}"
                                BorderThickness="1"
                                CornerRadius="2"
                                ClipToBounds="True">
                            <Panel>
                                <Border Background="{StaticResource AeroProgressTrackGloss}" CornerRadius="1"/>
                                <Border Name="PART_Indicator"
                                        Background="{DynamicResource Aero.Progress.Fill}"
                                        ClipToBounds="True"
                                        IsVisible="{Binding !IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Panel>
                                        <Border Background="{StaticResource AeroProgressGlow}"/>
                                        <Border Width="6" HorizontalAlignment="Left" Background="{StaticResource AeroProgressEdgeLeft}"/>
                                        <Border Width="6" HorizontalAlignment="Right" Background="{StaticResource AeroProgressEdgeRight}"/>
                                        <Border Background="{StaticResource AeroProgressHighlight}"/>
                                        <Rectangle Name="AeroProgressGlint"
                                                   Width="100"
                                                   HorizontalAlignment="Left"
                                                   Fill="{StaticResource AeroProgressGlint}"
                                                   IsHitTestVisible="False"/>
                                    </Panel>
                                </Border>
                                <Border Name="PART_IndeterminateIndicator"
                                        Background="{StaticResource AeroProgressMarquee}"
                                        IsVisible="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource AeroProgressHighlight}"/>
                                </Border>
                                <Border BorderBrush="#60FFFFFF" BorderThickness="1,0,1,1" CornerRadius="1" IsHitTestVisible="False"/>
                            </Panel>
                        </Border>
                        <LayoutTransformControl Name="PART_LayoutTransformControl"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ShowProgressText, RelativeSource={RelativeSource TemplatedParent}}">
                            <TextBlock Foreground="{DynamicResource Aero.Progress.Text}"
                                       Text="{Binding Percentage, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}"/>
                        </LayoutTransformControl>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:horizontal /template/ Border#PART_Indicator">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
            </Style>
            <Style Selector="^:vertical /template/ Border#PART_Indicator">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Style>
            <Style Selector="^:vertical /template/ LayoutTransformControl#PART_LayoutTransformControl">
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <RotateTransform Angle="90"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The glint travels across the fill at about 200 px/s and pauses before the next pass. -->
            <Style Selector="^:horizontal:not(:indeterminate) /template/ Rectangle#AeroProgressGlint">
                <Style.Animations>
                    <Animation Easing="LinearEasing" IterationCount="Infinite" Duration="0:0:3.2">
                        <KeyFrame Cue="0%">
                            <Setter Property="TranslateTransform.X" Value="-100"/>
                        </KeyFrame>
                        <KeyFrame Cue="72%">
                            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].Bounds.Width}"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].Bounds.Width}"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
            <Style Selector="^:vertical /template/ Rectangle#AeroProgressGlint">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <!-- Marquee: a glossy green block sweeps across the track. -->
            <Style Selector="^:horizontal:indeterminate /template/ Border#PART_IndeterminateIndicator">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Width" Value="{Binding TemplateSettings.ContainerWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Style.Animations>
                    <Animation Easing="LinearEasing" IterationCount="Infinite" Duration="0:0:2">
                        <KeyFrame Cue="0%">
                            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateStartingOffset}"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateEndingOffset}"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
            <Style Selector="^:vertical:indeterminate /template/ Border#PART_IndeterminateIndicator">
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Height" Value="{Binding TemplateSettings.ContainerWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Style.Animations>
                    <Animation Easing="LinearEasing" IterationCount="Infinite" Duration="0:0:2">
                        <KeyFrame Cue="0%">
                            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateStartingOffset}"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateEndingOffset}"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </ControlTheme>

        <!-- ============================================================================================== -->
        <!-- Track bar: sunken channel, glossy pointed thumb, tick marks.                                    -->
        <!-- ============================================================================================== -->
        <ControlTheme x:Key="AeroSliderTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="AeroTrackBarThumbDown" TargetType="Thumb">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Path Name="AeroThumbShape"
                              Data="M 9.5,1.5 A 1,1 0 0 0 8.5,0.5 L 1.5,0.5 A 1,1 0 0 0 0.5,1.5 L 0.5,13.5 L 4.5,17.5 L 5.5,17.5 L 9.5,13.5 Z"
                              Fill="{DynamicResource Aero.TrackBar.Thumb}"
                              Stroke="{DynamicResource Aero.TrackBar.Thumb.Border}"
                              StrokeThickness="1"/>
                        <Path Name="AeroThumbHot"
                              Data="M 9.5,1.5 A 1,1 0 0 0 8.5,0.5 L 1.5,0.5 A 1,1 0 0 0 0.5,1.5 L 0.5,13.5 L 4.5,17.5 L 5.5,17.5 L 9.5,13.5 Z"
                              Fill="{DynamicResource Aero.TrackBar.Thumb.Hot}"
                              Stroke="{DynamicResource Aero.TrackBar.Thumb.Border.Hot}"
                              StrokeThickness="1"
                              Opacity="0">
                            <Path.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Path.Transitions>
                        </Path>
                        <Path Name="AeroThumbPressed"
                              Data="M 9.5,1.5 A 1,1 0 0 0 8.5,0.5 L 1.5,0.5 A 1,1 0 0 0 0.5,1.5 L 0.5,13.5 L 4.5,17.5 L 5.5,17.5 L 9.5,13.5 Z"
                              Fill="{DynamicResource Aero.TrackBar.Thumb.Pressed}"
                              Stroke="{DynamicResource Aero.TrackBar.Thumb.Border.Pressed}"
                              StrokeThickness="1"
                              Opacity="0"/>
                        <Path Data="M 8.5,2 L 8.5,13 L 5,16.5 L 1.5,13 L 1.5,2"
                              Stroke="#B0FFFFFF"
                              StrokeThickness="1"
                              IsHitTestVisible="False"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Path#AeroThumbHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Path#AeroThumbPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:disabled /template/ Path#AeroThumbShape">
                <Setter Property="Fill" Value="{DynamicResource Aero.TrackBar.Thumb.Disabled}"/>
                <Setter Property="Stroke" Value="{DynamicResource Aero.TrackBar.Thumb.Border.Disabled}"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroTrackBarThumbRight" TargetType="Thumb">
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Path Name="AeroThumbShape"
                              Data="M 1.5,9.5 A 1,1 0 0 1 0.5,8.5 L 0.5,1.5 A 1,1 0 0 1 1.5,0.5 L 13.5,0.5 L 17.5,4.5 L 17.5,5.5 L 13.5,9.5 Z"
                              Fill="{DynamicResource Aero.TrackBar.Thumb.Vertical}"
                              Stroke="{DynamicResource Aero.TrackBar.Thumb.Border}"
                              StrokeThickness="1"/>
                        <Path Name="AeroThumbHot"
                              Data="M 1.5,9.5 A 1,1 0 0 1 0.5,8.5 L 0.5,1.5 A 1,1 0 0 1 1.5,0.5 L 13.5,0.5 L 17.5,4.5 L 17.5,5.5 L 13.5,9.5 Z"
                              Fill="{DynamicResource Aero.TrackBar.Thumb.Hot.Vertical}"
                              Stroke="{DynamicResource Aero.TrackBar.Thumb.Border.Hot}"
                              StrokeThickness="1"
                              Opacity="0">
                            <Path.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Path.Transitions>
                        </Path>
                        <Path Name="AeroThumbPressed"
                              Data="M 1.5,9.5 A 1,1 0 0 1 0.5,8.5 L 0.5,1.5 A 1,1 0 0 1 1.5,0.5 L 13.5,0.5 L 17.5,4.5 L 17.5,5.5 L 13.5,9.5 Z"
                              Fill="{DynamicResource Aero.TrackBar.Thumb.Pressed.Vertical}"
                              Stroke="{DynamicResource Aero.TrackBar.Thumb.Border.Pressed}"
                              StrokeThickness="1"
                              Opacity="0"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Path#AeroThumbHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Path#AeroThumbPressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:disabled /template/ Path#AeroThumbShape">
                <Setter Property="Fill" Value="{DynamicResource Aero.TrackBar.Thumb.Disabled}"/>
                <Setter Property="Stroke" Value="{DynamicResource Aero.TrackBar.Thumb.Border.Disabled}"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroSlider" TargetType="Slider">
            <Style Selector="^:horizontal">
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Name="AeroTrackBar" RowDefinitions="*,Auto">
                            <Border Name="AeroChannel"
                                    Height="4"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Aero.TrackBar.Track}"
                                    BorderBrush="{DynamicResource Aero.TrackBar.Track.Border}"
                                    BorderThickness="1"/>
                            <Track Name="PART_Track"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource AeroSliderTrack}"/>
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource AeroSliderTrack}"/>
                                </Track.IncreaseButton>
                                <Thumb Name="AeroSliderThumb" Theme="{StaticResource AeroTrackBarThumbDown}"/>
                            </Track>
                            <TickBar Name="AeroTicks"
                                     Grid.Row="1"
                                     Height="4"
                                     Margin="5,1,5,0"
                                     Fill="{DynamicResource Aero.TrackBar.Tick}"
                                     Placement="Bottom"
                                     Minimum="{TemplateBinding Minimum}"
                                     Maximum="{TemplateBinding Maximum}"
                                     TickFrequency="{TemplateBinding TickFrequency}"
                                     Ticks="{TemplateBinding Ticks}"
                                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                     Orientation="Horizontal"/>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="^:vertical">
                <Setter Property="MinWidth" Value="26"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Name="AeroTrackBar" ColumnDefinitions="*,Auto">
                            <Border Name="AeroChannel"
                                    Width="4"
                                    Margin="0,5"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource Aero.TrackBar.Track}"
                                    BorderBrush="{DynamicResource Aero.TrackBar.Track.Border}"
                                    BorderThickness="1"/>
                            <Track Name="PART_Track"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Orientation="Vertical"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource AeroSliderTrack}"/>
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource AeroSliderTrack}"/>
                                </Track.IncreaseButton>
                                <Thumb Name="AeroSliderThumb" Theme="{StaticResource AeroTrackBarThumbRight}"/>
                            </Track>
                            <TickBar Name="AeroTicks"
                                     Grid.Column="1"
                                     Width="4"
                                     Margin="1,5,0,5"
                                     Fill="{DynamicResource Aero.TrackBar.Tick}"
                                     Placement="Right"
                                     Minimum="{TemplateBinding Minimum}"
                                     Maximum="{TemplateBinding Maximum}"
                                     TickFrequency="{TemplateBinding TickFrequency}"
                                     Ticks="{TemplateBinding Ticks}"
                                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                     Orientation="Vertical"/>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Style>
        </ControlTheme>

        <!-- ============================================================================================== -->
        <!-- Numeric up-down: a text box with two small push buttons on the right.                          -->
        <!-- ============================================================================================== -->
        <ControlTheme x:Key="AeroSpinButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Aero.Glyph}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Background="{DynamicResource Aero.Button.Face}"
                                BorderBrush="{DynamicResource Aero.Button.Border}"
                                BorderThickness="1"
                                CornerRadius="2"/>
                        <Border Name="AeroChromeHot"
                                Background="{DynamicResource Aero.Button.Face.Hot}"
                                BorderBrush="{DynamicResource Aero.Button.Border.Hot}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="AeroChromePressed"
                                Background="{DynamicResource Aero.Button.Face.Pressed}"
                                BorderBrush="{DynamicResource Aero.Button.Border.Pressed}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0"/>
                        <Border Name="AeroChromeInner"
                                Margin="1"
                                BorderBrush="{DynamicResource Aero.Button.InnerBorder}"
                                BorderThickness="1"
                                CornerRadius="1"/>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#AeroChromeHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroChromePressed">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#AeroChromeInner">
                <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource Aero.Glyph.Disabled}"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroButtonSpinner" TargetType="ButtonSpinner">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Panel>
                            <Border Name="AeroEditBorder"
                                    Background="{DynamicResource Aero.Edit.Background}"
                                    BorderBrush="{DynamicResource Aero.Edit.Border}"
                                    BorderThickness="1"/>
                            <Border Name="AeroEditHot"
                                    BorderBrush="{DynamicResource Aero.Edit.Border.Hot}"
                                    BorderThickness="1"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Border Name="AeroEditFocus"
                                    BorderBrush="{DynamicResource Aero.Edit.Border.Focus}"
                                    BorderThickness="1"
                                    Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <DockPanel Margin="1">
                                <UniformGrid Name="PART_SpinnerPanel"
                                             Width="15"
                                             TabIndex="2"
                                             DockPanel.Dock="Right"
                                             IsVisible="{TemplateBinding ShowButtonSpinner}"
                                             Rows="2">
                                    <RepeatButton Name="PART_IncreaseButton"
                                                  IsTabStop="{TemplateBinding IsTabStop}"
                                                  Theme="{StaticResource AeroSpinButton}">
                                        <Path Data="M 0,4 L 3.5,0 L 7,4 Z" Fill="{Binding $parent[RepeatButton].Foreground}"/>
                                    </RepeatButton>
                                    <RepeatButton Name="PART_DecreaseButton"
                                                  IsTabStop="{TemplateBinding IsTabStop}"
                                                  Theme="{StaticResource AeroSpinButton}">
                                        <Path Data="M 0,0 L 7,0 L 3.5,4 Z" Fill="{Binding $parent[RepeatButton].Foreground}"/>
                                    </RepeatButton>
                                </UniformGrid>
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  TabIndex="1"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </DockPanel>
                        </Panel>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:left /template/ UniformGrid#PART_SpinnerPanel">
                <Setter Property="DockPanel.Dock" Value="Left"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#AeroEditHot">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:focus-within /template/ Border#AeroEditFocus">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:disabled /template/ Border#AeroEditBorder">
                <Setter Property="Background" Value="{DynamicResource Aero.Edit.Background.Disabled}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Aero.Edit.Border.Disabled}"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AeroNumericUpDown" TargetType="NumericUpDown">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Text}"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="MinHeight" Value="{StaticResource Aero.ControlHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <ButtonSpinner Name="PART_Spinner"
                                       HorizontalContentAlignment="Stretch"
                                       VerticalContentAlignment="Stretch"
                                       IsTabStop="False"
                                       MinWidth="0"
                                       AllowSpin="{TemplateBinding AllowSpin}"
                                       ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}"
                                       ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                                       Theme="{StaticResource AeroButtonSpinner}">
                            <TextBox Name="PART_TextBox"
                                     Classes="aero-inner"
                                     MinWidth="20"
                                     Padding="{TemplateBinding Padding}"
                                     VerticalAlignment="Center"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                     AcceptsReturn="False"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Text="{TemplateBinding Text}"
                                     TextAlignment="{TemplateBinding TextAlignment}"
                                     TextWrapping="NoWrap"
                                     PlaceholderText="{TemplateBinding PlaceholderText}"
                                     InnerLeftContent="{Binding InnerLeftContent, RelativeSource={RelativeSource TemplatedParent}}"
                                     InnerRightContent="{Binding InnerRightContent, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </ButtonSpinner>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- ============================================================================================== -->
        <!-- Menus: icon gutter with a double line, rounded translucent blue highlight.                      -->
        <!-- ============================================================================================== -->
        <ControlTheme x:Key="AeroMenuScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsScrollChainingEnabled" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ScrollContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="AeroContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Menu.Text}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="TextBlock.FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="AeroMenuSurface"
                            Background="{DynamicResource Aero.Menu.Background}"
                            BorderBrush="{DynamicResource Aero.Menu.Border}"
                            BorderThickness="1"
                            Padding="2">
                        <Panel>
                            <Border Width="28" HorizontalAlignment="Left" Margin="1,0,0,0" CornerRadius="2" Background="{DynamicResource Aero.Menu.Gutter}"/>
                            <Rectangle Width="1" HorizontalAlignment="Left" Margin="29,0,0,0" Fill="{DynamicResource Aero.Menu.Gutter.Line}"/>
                            <Rectangle Width="1" HorizontalAlignment="Left" Margin="30,0,0,0" Fill="{DynamicResource Aero.Menu.Gutter.Light}"/>
                            <ScrollViewer Theme="{StaticResource AeroMenuScrollViewer}">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                Grid.IsSharedSizeScope="True"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                KeyboardNavigation.TabNavigation="Continue"/>
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="AeroMenuFlyoutPresenter" TargetType="MenuFlyoutPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Menu.Text}"/>
            <Setter Property="TextBlock.FontWeight" Value="Normal"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="AeroMenuSurface"
                            Background="{DynamicResource Aero.Menu.Background}"
                            BorderBrush="{DynamicResource Aero.Menu.Border}"
                            BorderThickness="1"
                            Padding="2">
                        <Panel>
                            <Border Width="28" HorizontalAlignment="Left" Margin="1,0,0,0" CornerRadius="2" Background="{DynamicResource Aero.Menu.Gutter}"/>
                            <Rectangle Width="1" HorizontalAlignment="Left" Margin="29,0,0,0" Fill="{DynamicResource Aero.Menu.Gutter.Line}"/>
                            <Rectangle Width="1" HorizontalAlignment="Left" Margin="30,0,0,0" Fill="{DynamicResource Aero.Menu.Gutter.Light}"/>
                            <ScrollViewer Theme="{StaticResource AeroMenuScrollViewer}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                Grid.IsSharedSizeScope="True"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                KeyboardNavigation.TabNavigation="Continue"/>
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="AeroMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Aero.Menu.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Name="AeroMenuRow" MinHeight="{TemplateBinding MinHeight}" Background="Transparent">
                        <Border Name="AeroMenuHighlight"
                                Background="{DynamicResource Aero.Menu.Highlight}"
                                BorderBrush="{DynamicResource Aero.Menu.Highlight.Border}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                                </Transitions>
                            </Border.Transitions>
                            <Border BorderBrush="{DynamicResource Aero.Menu.Highlight.Inner}" BorderThickness="1" CornerRadius="2"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="7"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGT"/>
                                <ColumnDefinition Width="17"/>
                            </Grid.ColumnDefinitions>
                            <Border Name="AeroCheckBackground"
                                    Width="22"
                                    Height="22"
                                    CornerRadius="3"
                                    Background="{DynamicResource Aero.Menu.Checked}"
                                    BorderBrush="{DynamicResource Aero.Menu.Checked.Border}"
                                    BorderThickness="1"
                                    IsVisible="False"/>
                            <ContentControl Name="PART_ToggleIconPresenter"
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="False"/>
                            <ContentControl Name="PART_IconPresenter"
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Icon}"/>
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Grid.Column="2"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              RecognizesAccessKey="True"/>
                            <TextBlock Name="PART_InputGestureText"
                                       Grid.Column="3"
                                       Margin="37,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding InputGesture, Converter={StaticResource AeroKeyGestureConverter}}"/>
                            <Path Name="AeroSubmenuArrow"
                                  Grid.Column="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 4,3.5 L 0,7 Z"
                                  Fill="{DynamicResource Aero.Menu.Text}"/>
                            <Popup Name="PART_Popup"
                                   IsLightDismissEnabled="False"
                                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                                   Placement="RightEdgeAlignedTop"
                                   HorizontalOffset="-2"
                                   VerticalOffset="-3">
                                <Border Name="AeroMenuSurface"
                                        Background="{DynamicResource Aero.Menu.Background}"
                                        BorderBrush="{DynamicResource Aero.Menu.Border}"
                                        BorderThickness="1"
                                        Padding="2">
                                    <Panel>
                                        <Border Width="28" HorizontalAlignment="Left" Margin="1,0,0,0" CornerRadius="2" Background="{DynamicResource Aero.Menu.Gutter}"/>
                                        <Rectangle Width="1" HorizontalAlignment="Left" Margin="29,0,0,0" Fill="{DynamicResource Aero.Menu.Gutter.Line}"/>
                                        <Rectangle Width="1" HorizontalAlignment="Left" Margin="30,0,0,0" Fill="{DynamicResource Aero.Menu.Gutter.Light}"/>
                                        <ScrollViewer Theme="{StaticResource AeroMenuScrollViewer}">
                                            <ItemsPresenter Name="PART_ItemsPresenter"
                                                            Grid.IsSharedSizeScope="True"
                                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                        </ScrollViewer>
                                    </Panel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:separator">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Separator/>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="^:selected /template/ Border#AeroMenuHighlight, ^:pressed /template/ Border#AeroMenuHighlight, ^:open /template/ Border#AeroMenuHighlight">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:empty /template/ Path#AeroSubmenuArrow">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource Aero.GrayText}"/>
            </Style>
            <Style Selector="^:disabled /template/ Border#AeroMenuHighlight">
                <Setter Property="Background" Value="{DynamicResource Aero.Menu.Highlight.Disabled}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Aero.Menu.Highlight.Border.Disabled}"/>
            </Style>
            <Style Selector="^:toggle /template/ ContentControl#PART_ToggleIconPresenter, ^:radio /template/ ContentControl#PART_ToggleIconPresenter">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:toggle /template/ ContentControl#PART_IconPresenter, ^:radio /template/ ContentControl#PART_IconPresenter">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^:checked /template/ Border#AeroCheckBackground">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter">
                <Setter Property="Content">
                    <Template>
                        <Path Margin="3,2,0,0"
                              Data="M 0,5.1 L 1.7,5.2 L 3.4,7.1 L 8,0.4 L 9.2,0 L 3.3,10.8 Z"
                              Fill="{DynamicResource Aero.Menu.Checked.Glyph}"/>
                    </Template>
                </Setter>
            </Style>
            <Style Selector="^:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
                <Setter Property="Content">
                    <Template>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Aero.Menu.Checked.Glyph}"/>
                    </Template>
                </Setter>
            </Style>
        </ControlTheme>

        <!-- Menu separator: a grey line with a white line under it, after the icon gutter. -->
        <ControlTheme x:Key="AeroSeparator" TargetType="Separator">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <Rectangle Height="1" Fill="{DynamicResource Aero.Menu.Separator}"/>
                        <Rectangle Height="1" Fill="{DynamicResource Aero.Menu.Separator.Light}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Tool tip: white to lavender gradient, rounded, grey text. -->
        <ControlTheme x:Key="AeroToolTip" TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Aero.ToolTip.Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="6,2,6,3"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Margin="0,0,3,3"
                                      Padding="{TemplateBinding Padding}"
                                      Background="{DynamicResource Aero.ToolTip.Background}"
                                      BorderBrush="{DynamicResource Aero.ToolTip.Border}"
                                      BorderThickness="1"
                                      CornerRadius="3"
                                      BoxShadow="1 1 3 0 #38000000"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Link: Windows 7 link blue, underlined while hot. -->
        <ControlTheme x:Key="AeroHyperlinkButton" TargetType="HyperlinkButton">
            <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Link}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="Transparent"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      RecognizesAccessKey="True"/>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="#3399FF"/>
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!-- ================================================================================================== -->
    <!-- Window frame                                                                                       -->
    <!-- ================================================================================================== -->
    <Style Selector=":is(Window).aero-frame">
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True"/>
        <Setter Property="WindowDecorationsTheme" Value="{StaticResource AeroWindowDecorations}"/>
        <Setter Property="TransparencyBackgroundFallback" Value="Transparent"/>
        <Setter Property="Padding" Value="7,30,7,7"/>
    </Style>
    <Style Selector=":is(Window).aero-frame.aero-glass">
        <Setter Property="TransparencyLevelHint" Value="AcrylicBlur, None"/>
    </Style>
    <Style Selector=":is(Window).aero-frame.aero-maximized">
        <Setter Property="Padding" Value="0,22,0,0"/>
    </Style>
    <!-- The frame shows through the window background; the client area keeps the window background. -->
    <Style Selector=":is(Window).aero-frame /template/ Border">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector=":is(Window).aero-frame /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
    </Style>

    <!-- Base typography: 9pt Segoe UI, regular weight. -->
    <Style Selector=":is(Window)">
        <Setter Property="FontFamily" Value="Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="{DynamicResource ShareX.FontSize.Default}"/>
    </Style>
    <Style Selector="AccessText">
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <!-- Windows 7 shows focus with the control itself (blue borders, the default ring, a dotted cue), not an adorner. -->
    <Style Selector=":is(Control)">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <!-- ================================================================================================== -->
    <!-- Control themes                                                                                     -->
    <!-- ================================================================================================== -->
    <Style Selector="Button">
        <Setter Property="Theme" Value="{StaticResource AeroButton}"/>
        <Setter Property="Height" Value="NaN"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="10,1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="RepeatButton">
        <Setter Property="Theme" Value="{StaticResource AeroRepeatButton}"/>
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="Theme" Value="{StaticResource AeroToggleButton}"/>
    </Style>
    <Style Selector="Button.nav-button, Button.picker-button, Button.toolbar-button, Button.transparent-button,
                     Button.caption-button, Button.player-button, Button.tool-grid-button, Button.tool-grid-edit-button,
                     Button.effect-item, Button.icon-button">
        <Setter Property="Theme" Value="{StaticResource AeroToolButton}"/>
    </Style>
    <Style Selector="Button.nav-button">
        <Setter Property="Theme" Value="{StaticResource AeroNavButton}"/>
    </Style>
    <Style Selector="ToggleButton.side-panel-toggle-row, ToggleButton.tool-grid-visibility-button">
        <Setter Property="Theme" Value="{StaticResource AeroToolToggleButton}"/>
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Theme" Value="{StaticResource AeroCheckBox}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Theme" Value="{StaticResource AeroRadioButton}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="Theme" Value="{StaticResource AeroToggleSwitch}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Theme" Value="{StaticResource AeroTextBox}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="TextBox.aero-inner">
        <Setter Property="Theme" Value="{StaticResource AeroInnerTextBox}"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Theme" Value="{StaticResource AeroComboBox}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Theme" Value="{StaticResource AeroComboBoxItem}"/>
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Theme" Value="{StaticResource AeroListBox}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Theme" Value="{StaticResource AeroListBoxItem}"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <!--
        The color view's palette is a list box of swatches. Its item theme comes from ItemContainerTheme, which the
        list box only applies to containers without a theme, so the type style above would turn every swatch into a
        list row. Give the swatches their own theme back.
    -->
    <Style Selector="cp|ColorView ListBoxItem">
        <Setter Property="Theme" Value="{DynamicResource ColorViewPaletteListBoxItemTheme}"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <!-- The color button's swatch is shorter so it clears the top and bottom of the 23 px button. -->
    <Style Selector="Grid.color-swatch">
        <Setter Property="Height" Value="15"/>
    </Style>
    <Style Selector="cp|ColorView, cpp|ColorPreviewer">
        <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="TreeView">
        <Setter Property="Theme" Value="{StaticResource AeroTreeView}"/>
    </Style>
    <Style Selector="TreeViewItem">
        <Setter Property="Theme" Value="{StaticResource AeroTreeViewItem}"/>
    </Style>
    <Style Selector="ScrollViewer">
        <Setter Property="Theme" Value="{StaticResource AeroScrollViewer}"/>
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Theme" Value="{StaticResource AeroScrollBar}"/>
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="Theme" Value="{StaticResource AeroProgressBar}"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="Slider">
        <Setter Property="Theme" Value="{StaticResource AeroSlider}"/>
    </Style>
    <Style Selector="ButtonSpinner">
        <Setter Property="Theme" Value="{StaticResource AeroButtonSpinner}"/>
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="Theme" Value="{StaticResource AeroNumericUpDown}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Theme" Value="{StaticResource AeroContextMenu}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Theme" Value="{StaticResource AeroMenuFlyoutPresenter}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Theme" Value="{StaticResource AeroMenuItem}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="Separator">
        <Setter Property="Theme" Value="{StaticResource AeroSeparator}"/>
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Theme" Value="{StaticResource AeroToolTip}"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="ToolTip, ToolTip TextBlock">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.ToolTip.Text}"/>
    </Style>
    <Style Selector="HyperlinkButton">
        <Setter Property="Theme" Value="{StaticResource AeroHyperlinkButton}"/>
    </Style>
    <Style Selector="HyperlinkButton:pointerover TextBlock, HyperlinkButton:pointerover /template/ TextBlock, HyperlinkButton:pointerover /template/ AccessText">
        <Setter Property="TextDecorations" Value="Underline"/>
    </Style>

    <!--
        Push buttons draw their face in separate layers. ControlStyles.axaml and the window styles paint
        PART_ContentPresenter under various conditions, so these repeat those selectors to keep it transparent.
    -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter, RepeatButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <!-- Selectors with and without states can't share a style: it would apply at the lower, stateless priority. -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter,
                     Button:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button:focus /template/ ContentPresenter#PART_ContentPresenter,
                     Button[IsDefault=True] /template/ ContentPresenter#PART_ContentPresenter,
                     Button.primary /template/ ContentPresenter#PART_ContentPresenter,
                     Button.active /template/ ContentPresenter#PART_ContentPresenter,
                     Button.active:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.active:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.task-mode-button.danger /template/ ContentPresenter#PART_ContentPresenter,
                     Button.task-mode-button.success /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button:disabled, ToggleButton:disabled, RepeatButton:disabled">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Button.Text.Disabled}"/>
    </Style>
    <Style Selector="Button:disabled TextBlock, ToggleButton:disabled TextBlock">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Button.Text.Disabled}"/>
    </Style>
    <!-- The focused or default button shows the cyan inner ring; the default button pulses while its window is active. -->
    <Style Selector="Button:focus /template/ Border#AeroChromeDefault, Button[IsDefault=True] /template/ Border#AeroChromeDefault">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button:focus-visible /template/ Rectangle#AeroFocusCue, ToggleButton:focus-visible /template/ Rectangle#AeroFocusCue">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=":is(Window).aero-active Button[IsDefault=True]:not(:pointerover):not(:pressed):not(:disabled) /template/ Border#AeroChromeHalo">
        <Style.Animations>
            <Animation Duration="0:0:2" Delay="0:0:0.4" IterationCount="Infinite">
                <Animation.Easing>
                    <theming:AeroStepEasing Steps="16"/>
                </Animation.Easing>
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="30%">
                    <Setter Property="Opacity" Value="0.75"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector=":is(Window).aero-active Button[IsDefault=True]:not(:pointerover):not(:pressed):not(:disabled) /template/ Border#AeroChromeHot">
        <Style.Animations>
            <Animation Duration="0:0:2" Delay="0:0:0.4" IterationCount="Infinite">
                <Animation.Easing>
                    <theming:AeroStepEasing Steps="16"/>
                </Animation.Easing>
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="25%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="37.5%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Accent and state colored buttons (primary, active, task mode) keep black text on the Aero face. -->
    <Style Selector="Button.primary, Button.active, Button.task-mode-button, Button.danger, Button.success">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
    </Style>
    <Style Selector="Button.primary TextBlock, Button.active TextBlock, Button.task-mode-button TextBlock,
                     Button.active /template/ ContentPresenter#PART_ContentPresenter TextBlock,
                     Button.primary controls|IconPresenter, Button.active controls|IconPresenter,
                     Button.active /template/ ContentPresenter#PART_ContentPresenter controls|IconPresenter,
                     Button.task-mode-button.danger > TextBlock, Button.task-mode-button.success > TextBlock">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
    </Style>

    <!-- Command bar buttons (repeat the flat-button selectors used by ControlStyles and the windows). -->
    <Style Selector="Button.nav-button, Button.picker-button, Button.toolbar-button, Button.transparent-button,
                     Button.caption-button, Button.player-button, Button.tool-grid-button, Button.tool-grid-edit-button,
                     Button.effect-item, Button.icon-button,
                     ToggleButton.side-panel-toggle-row, ToggleButton.tool-grid-visibility-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ^:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         ^:checked /template/ ContentPresenter#PART_ContentPresenter,
                         ^.active /template/ ContentPresenter#PART_ContentPresenter,
                         ^.active:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="^.active, ^.active TextBlock, ^.active controls|IconPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
        </Style>
    </Style>

    <!-- Drop-down items: highlight blue with white text. -->
    <Style Selector="ComboBoxItem">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinHeight" Value="18"/>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ^:selected:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         ^:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                         ^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Aero.Highlight}"/>
        </Style>
        <Style Selector="^:selected, ^:selected TextBlock, ^:selected controls|IconPresenter,
                         ^:pointerover, ^:pointerover TextBlock">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.HighlightText}"/>
        </Style>
        <Style Selector="^:disabled, ^:disabled TextBlock">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.GrayText}"/>
        </Style>
    </Style>

    <!-- List box items keep black text on the Explorer selection. -->
    <Style Selector="ListBoxItem">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ^:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ^:selected:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         ^:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="^:selected, ^:selected TextBlock, ^:selected controls|IconPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
        </Style>
        <Style Selector="^:disabled, ^:disabled TextBlock">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.GrayText}"/>
        </Style>
    </Style>
    <!-- Palette swatches show their selection with their own outline. -->
    <Style Selector="cp|ColorView ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Text inputs: the inner text box of a NumericUpDown is borderless (ControlStyles restyles it). -->
    <Style Selector="NumericUpDown /template/ TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox:pointerover, NumericUpDown /template/ TextBox:focus">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
    </Style>
    <Style Selector="TextBox /template/ TextPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ TextPresenter, TextBox:focus /template/ TextPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
    </Style>
    <Style Selector="TextBox:disabled /template/ TextPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.GrayText}"/>
    </Style>

    <!-- Menus: 22px items, 9pt text, icon gutter on the left. -->
    <Style Selector="ContextMenu MenuItem, MenuFlyoutPresenter MenuItem">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Menu.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="Height" Value="NaN"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <!-- The compact menus keep the item height and padding of the menu spacing setting. -->
    <Style Selector="MenuItem.compact-menu-item">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Menu.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="ContextMenu MenuItem:pointerover, MenuFlyoutPresenter MenuItem:pointerover, MenuItem.compact-menu-item:pointerover,
                     ContextMenu MenuItem:pointerover TextBlock, MenuFlyoutPresenter MenuItem:pointerover TextBlock,
                     MenuItem.compact-menu-item:pointerover TextBlock,
                     ContextMenu MenuItem:pointerover /template/ TextBlock">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Menu.Text}"/>
    </Style>
    <Style Selector="MenuItem:disabled TextBlock">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.GrayText}"/>
    </Style>
    <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator">
        <Setter Property="Margin" Value="31,3,1,3"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Separator.compact-menu-separator">
        <Setter Property="Margin" Value="31,3,1,3"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Tree rows light up while the row itself (not a child row) is hot. -->
    <Style Selector="TreeViewItem /template/ Panel#AeroTreeRow:pointerover > Border#AeroItemHot">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Settings tree rows: 9pt Segoe UI with black text on the Explorer selection. -->
    <Style Selector="TreeView TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter TextBlock">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
    </Style>

    <!-- Group boxes: the setting cards become etched, rounded Windows 7 group boxes. -->
    <Style Selector="Border.section-card">
        <Setter Property="Background" Value="{DynamicResource Aero.GroupBox.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.GroupBox.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="9,8,9,9"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style Selector="Border.section-card TextBlock.section-title">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="-3,-17,0,0"/>
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Main}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Aero.Text}"/>
    </Style>
    <Style Selector="Border.card, Border.setting-card, Border.panel-card, Border.content-card, Border.info-card,
                     Border.choice-card, Border.metric-card, Border.converter-panel, Border.comparer-panel,
                     Border.remover-panel, Border.tool-panel, Border.thumbnail-card, Border.message-group">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.GroupBox.Border}"/>
    </Style>
    <Style Selector="Border.popup-border, Border.popup-surface, Border.floating-panel, Border.color-picker-popup, Border.app-toast">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Menu.Border}"/>
    </Style>
    <Style Selector="Border.capsule, Border.tool-grid-badge">
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource Aero.Menu.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Menu.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="FlyoutPresenter.tool-grid-flyout, FlyoutPresenter.gradient-options-flyout">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource Aero.Menu.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Menu.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!--
        Color picker drop-down: drawn like the drop-down lists beside it. The arrow replaces the button's own chevron,
        and the generic push-button states above must not paint its content area.
    -->
    <Style Selector="Button.color-dropdown-button">
        <Setter Property="Theme" Value="{StaticResource AeroDropDownComboButton}"/>
    </Style>
    <Style Selector="Button.color-dropdown-button controls|IconPresenter.dropdown-chevron">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.color-dropdown-button /template/ ContentPresenter#PART_ContentPresenter,
                     Button.color-dropdown-button:not(:pointerover):not(:pressed) /template/ ContentPresenter#PART_ContentPresenter,
                     Button.color-dropdown-button:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.color-dropdown-button:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.color-dropdown-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Page headings use the Windows 7 main instruction style: 12pt, dark blue. -->
    <Style Selector="TextBlock.page-title-text">
        <Setter Property="Foreground" Value="{DynamicResource Aero.MainInstruction.Text}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="controls|IconPresenter.page-title-icon">
        <Setter Property="Foreground" Value="{DynamicResource Aero.MainInstruction.Text}"/>
    </Style>

    <!-- ================================================================================================== -->
    <!-- Motion: menus, drop-downs and tool tips fade in and settle; settings pages slide in.               -->
    <!-- Only Opacity and render transforms change, through transitions that follow the open state.         -->
    <!-- ================================================================================================== -->
    <!--
        Menus, drop-downs and tool tips open with transitions rather than animations: their open state can turn off and
        on again while the pointer moves (as it does for submenus and settings pages, below), which would restart an
        animation from transparent. A transition carries on from the current value, so only a real opening fades in.
    -->
    <Style Selector="ContextMenu /template/ Border#AeroMenuSurface">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="translateY(-5px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <!-- ContextMenu has no :open pseudo-class; its IsOpen property says when it is shown. -->
    <Style Selector="ContextMenu[IsOpen=True] /template/ Border#AeroMenuSurface">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter /template/ Border#AeroMenuSurface">
        <Style.Animations>
            <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="TranslateTransform.Y" Value="-5"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!--
        Submenus fade in with transitions rather than an animation. While the pointer moves over a parent item, Avalonia
        can turn its submenu's open state off and on again; an animation would restart from transparent each time, but a
        transition carries on from the current value, so only a real opening fades in.
    -->
    <Style Selector="MenuItem /template/ Border#AeroMenuSurface">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="translateY(-5px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="MenuItem:open /template/ Border#AeroMenuSurface">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="ComboBox /template/ Border#AeroMenuSurface">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="translateY(-5px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#AeroMenuSurface">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="ToolTip /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="SineEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToolTip:open /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <!--
        Settings pages slide in with transitions rather than an animation, for the same reason as submenus: flicking
        between pages turns a page's visibility off and on again, which would restart an animation from transparent.
        A page that is shown again carries on from where its transition had got to.
    -->
    <Style Selector="ScrollViewer StackPanel.settings-page">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="translateX(16px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollViewer[IsVisible=True] StackPanel.settings-page">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="none"/>
    </Style>

    <!-- ================================================================================================== -->
    <!-- Light and glass                                                                                    -->
    <!-- ================================================================================================== -->
    <!-- Primary buttons are aqua glass, and glow while hot. -->
    <Style Selector="Button.primary /template/ Border#AeroChrome">
        <Setter Property="Background" Value="{DynamicResource Aero.Primary.Face}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Primary.Border}"/>
    </Style>
    <Style Selector="Button.primary /template/ Border#AeroChromeHot">
        <Setter Property="Background" Value="{DynamicResource Aero.Primary.Face.Hot}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Primary.Border}"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ Border#AeroChrome">
        <Setter Property="Background" Value="{DynamicResource Aero.Button.Face.Disabled}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Button.Border.Disabled}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#AeroChromeHalo, Button[IsDefault=True]:pointerover /template/ Border#AeroChromeHalo">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Page headings sit on a soft streak of light. -->
    <Style Selector="Grid.page-title">
        <Setter Property="Background" Value="{DynamicResource Aero.PageTitle.Glow}"/>
    </Style>

    <!-- The empty main window: a gadget on a small Frutiger Aero desktop. -->
    <Style Selector="Border.hotkey-panel">
        <Setter Property="Background" Value="{DynamicResource Aero.Gadget.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Gadget.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BoxShadow" Value="0 8 26 0 #3A002448, 0 1 3 0 #30000000"/>
    </Style>

    <!-- Start screen: glossy cards with glass icon tiles. -->
    <Style Selector="Border.setting-card">
        <Setter Property="Background" Value="{DynamicResource Aero.Card.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.GroupBox.Border}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
    </Style>
    <Style Selector="Border.setting-icon">
        <Setter Property="Background" Value="{DynamicResource Aero.Tile.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Aero.Tile.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #60FFFFFF"/>
    </Style>
    <Style Selector="Canvas.banner-bubbles">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Toasts get a glossy upper half and a bright rim over whatever colors they are set to. -->
    <Style Selector="ContentControl.aero-toast-gloss">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border CornerRadius="3" Background="{DynamicResource Aero.Toast.Gloss}"/>
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="#40FFFFFF"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ================================================================================================== -->
    <!-- Art                                                                                                -->
    <!-- Original vector art in the Frutiger Aero style: sky, light rays, aurora ribbons, bubbles and       -->
    <!-- bokeh. The brushes come from the theme dictionaries, so the art follows the accent color and the   -->
    <!-- light or dark theme.                                                                               -->
    <!-- ================================================================================================== -->
    <Style Selector="ContentControl.aero-banner-art">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{DynamicResource Aero.Art.Sky}"/>
                    <Border Background="{DynamicResource Aero.Art.Horizon}"/>
