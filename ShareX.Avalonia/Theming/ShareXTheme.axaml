            <x:Double x:Key="Classic.OptionControl.Height">38</x:Double>
            <!-- Menus use the system menu font (9pt); the themed combo box shows a chevron. -->
            <x:Double x:Key="Classic.Menu.FontSize">12</x:Double>
            <x:Boolean x:Key="Classic.Combo.Chevron">True</x:Boolean>
            <x:Boolean x:Key="Classic.Combo.Triangle">False</x:Boolean>
        </ResourceDictionary>

        <!-- ShareX Classic Dark: ShareXTheme.DarkTheme from ShareX 21 (Background #272727, LightBackground #2E2E2E,
             DarkBackground #222222, Text #E7E9EA, Border #1F1F1F, Link #A6D4FF). -->
        <ResourceDictionary x:Key="{x:Static helpers:ThemeManager.ShareXClassicDark}">
            <!-- 9pt Segoe UI, the ShareX 21 form font. -->
            <x:Double x:Key="ShareX.FontSize.Default">12</x:Double>
            <Color x:Key="ShareX.Color.Accent.Start">#0078D7</Color>
            <Color x:Key="ShareX.Color.Accent.End">#0078D7</Color>
