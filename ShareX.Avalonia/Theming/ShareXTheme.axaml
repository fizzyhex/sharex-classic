                <GradientStop Color="#E8553C" Offset="0.5" />
                <GradientStop Color="#F79478" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.CaptionClose.Pressed" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#D08A7A" Offset="0" />
                <GradientStop Color="#C0533F" Offset="0.5" />
                <GradientStop Color="#A8301C" Offset="0.5" />
                <GradientStop Color="#B8321F" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Aero.CaptionClose.Border" Color="#B0601408" />
            <RadialGradientBrush x:Key="Aero.CaptionClose.Glow" Center="50%,60%" GradientOrigin="50%,60%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#C0FF5A30" Offset="0" />
                <GradientStop Color="#60FF4A2E" Offset="0.55" />
                <GradientStop Color="#00FF4A2E" Offset="1" />
            </RadialGradientBrush>

            <!-- Tab strip of the color view (Avalonia.Controls.ColorPicker) -->
            <SolidColorBrush x:Key="ColorViewTabBackgroundBrush" Color="#F0F0F0" />
            <CornerRadius x:Key="ColorViewTabBackgroundCornerRadius">3</CornerRadius>
            <!-- Height of the start screen drop-downs, which the accent color picker matches. -->
            <x:Double x:Key="Classic.OptionControl.Height">30</x:Double>

            <!-- Caption text and caption button glows. -->
            <SolidColorBrush x:Key="Aero.Caption.Text" Color="#000000" />
            <SolidColorBrush x:Key="Aero.Caption.Text.Inactive" Color="#404040" />
            <RadialGradientBrush x:Key="Aero.Caption.TextGlow" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#E0FFFFFF" Offset="0" />
                <GradientStop Color="#B0FFFFFF" Offset="0.55" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Aero.Caption.Button.Glow" Center="50%,60%" GradientOrigin="50%,60%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#B048C8FF" Offset="0" />
                <GradientStop Color="#5038B4FF" Offset="0.55" />
                <GradientStop Color="#0038B4FF" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="Aero.Caption.Basic.Face" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F4F8FC" Offset="0" />
                <GradientStop Color="#DCE6F2" Offset="0.45" />
                <GradientStop Color="#C9D7E9" Offset="0.46" />
                <GradientStop Color="#D6E3F2" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Aero.Glass.Basic.Edge" Color="#8396AC" />
            <SolidColorBrush x:Key="Aero.Glass.Basic.Edge.Inactive" Color="#A0AFC3" />
            <SolidColorBrush x:Key="Aero.Glass.Highlight" Color="#70FFFFFF" />
            <SolidColorBrush x:Key="Aero.ClientEdge" Color="#A0384A5C" />
            <SolidColorBrush x:Key="Aero.ScrollBar.Thumb.Inner" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Aero.ScrollBar.Grip.Light" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Aero.GroupBox.Background" Color="Transparent" />

            <!-- Navigation panes: the Explorer pane gradient. -->
            <LinearGradientBrush x:Key="ShareX.Brush.Background.Toolbar" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F7FAFE" Offset="0" />
                <GradientStop Color="#EEF4FB" Offset="0.4" />
                <GradientStop Color="#E2ECF8" Offset="1" />
            </LinearGradientBrush>

            <!-- Start menu style glowing highlight of the navigation items. -->
            <LinearGradientBrush x:Key="Aero.Nav.Hot" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FBFDFF" Offset="0" />
                <GradientStop Color="#E4F2FE" Offset="0.48" />
                <GradientStop Color="#CFE7FC" Offset="0.5" />
                <GradientStop Color="#E0F1FF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Aero.Nav.Hot.Border" Color="#8DBFEA" />
            <LinearGradientBrush x:Key="Aero.Nav.Hot.Inner" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#E8FFFFFF" Offset="0" />
                <GradientStop Color="#50FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="Aero.Nav.Hot.Bloom" Center="50%,100%" GradientOrigin="50%,100%" RadiusX="62%" RadiusY="85%">
                <GradientStop Color="#8C5CC4FF" Offset="0" />
                <GradientStop Color="#285CC4FF" Offset="0.6" />
                <GradientStop Color="#005CC4FF" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="Aero.Nav.Pressed" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#CFE6FB" Offset="0" />
                <GradientStop Color="#BCDCF8" Offset="0.5" />
                <GradientStop Color="#A9D1F5" Offset="0.5" />
                <GradientStop Color="#C2E0F9" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Aero.Nav.Pressed.Border" Color="#5E9ACD" />

            <!-- Button glows: a bloom from the bottom edge while hot, and a halo around default and primary buttons. -->
            <RadialGradientBrush x:Key="Aero.Button.Bloom" Center="50%,100%" GradientOrigin="50%,100%" RadiusX="65%" RadiusY="90%">
                <GradientStop Color="#9A64D2FF" Offset="0" />
                <GradientStop Color="#3064D2FF" Offset="0.6" />
                <GradientStop Color="#0064D2FF" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Aero.Button.Halo" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#A040B4FF" Offset="0.55" />
                <GradientStop Color="#4840B4FF" Offset="0.8" />
                <GradientStop Color="#0040B4FF" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="Aero.Primary.Face" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#EAF6FF" Offset="0" />
                <GradientStop Color="#CDEBFF" Offset="0.5" />
                <GradientStop Color="#A6D9FB" Offset="0.5" />
                <GradientStop Color="#C4E7FD" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Primary.Face.Hot" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F4FBFF" Offset="0" />
                <GradientStop Color="#D8F1FF" Offset="0.5" />
                <GradientStop Color="#92D2FB" Offset="0.5" />
                <GradientStop Color="#BCE8FF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Aero.Primary.Border" Color="#3B80C2" />

            <!-- Gadgets: glossy cards and glass icon tiles. -->
            <LinearGradientBrush x:Key="Aero.Gadget.Background" StartPoint="0,0" EndPoint="0,50">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#EEF6FE" Offset="0.5" />
                <GradientStop Color="#DFEEFC" Offset="0.5" />
                <GradientStop Color="#EEF6FE" Offset="0.96" />
                <GradientStop Color="#C4D9EE" Offset="0.98" />
                <GradientStop Color="#FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Gadget.Border" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#BFD4E8" Offset="0" />
                <GradientStop Color="#8FABC8" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Gadget.Header" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#EDF6FE" Offset="0.5" />
                <GradientStop Color="#DDEEFC" Offset="0.5" />
                <GradientStop Color="#F2F8FE" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Card.Background" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#F4F9FE" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Tile.Background" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#EAF5FE" Offset="0.5" />
                <GradientStop Color="#D2E9FB" Offset="0.5" />
                <GradientStop Color="#EAF6FF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Aero.Tile.Border" Color="#9EC4E6" />
            <RadialGradientBrush x:Key="Aero.PageTitle.Glow" Center="0%,100%" GradientOrigin="0%,100%" RadiusX="75%" RadiusY="12%">
                <GradientStop Color="#8068B8F0" Offset="0" />
                <GradientStop Color="#3068B8F0" Offset="0.5" />
                <GradientStop Color="#0068B8F0" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="Aero.Toast.Gloss" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#48FFFFFF" Offset="0" />
                <GradientStop Color="#18FFFFFF" Offset="0.45" />
                <GradientStop Color="#00FFFFFF" Offset="0.46" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <!-- Frutiger Aero art: sky, light rays, aurora ribbons, bubbles. Blue and aqua hues follow the accent. -->
            <LinearGradientBrush x:Key="Aero.Art.Sky" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#0A52AD" Offset="0" />
                <GradientStop Color="#1670CF" Offset="0.38" />
                <GradientStop Color="#2690E4" Offset="0.68" />
                <GradientStop Color="#45B0EE" Offset="0.88" />
                <GradientStop Color="#78CDF6" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.Horizon" Center="80%,100%" GradientOrigin="80%,100%" RadiusX="95%" RadiusY="34%">
                <GradientStop Color="#B0EAFCFF" Offset="0" />
                <GradientStop Color="#3CA6E8FF" Offset="0.55" />
                <GradientStop Color="#00A6E8FF" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.TextPool" Center="35%,52%" GradientOrigin="35%,52%" RadiusX="80%" RadiusY="32%">
                <GradientStop Color="#58083A88" Offset="0" />
                <GradientStop Color="#00083A88" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.FooterPool" Center="15%,100%" GradientOrigin="15%,100%" RadiusX="90%" RadiusY="11%">
                <GradientStop Color="#B0083A88" Offset="0" />
                <GradientStop Color="#00083A88" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.Sun" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#D0FFFFFF" Offset="0" />
                <GradientStop Color="#50E8F8FF" Offset="0.3" />
                <GradientStop Color="#00E8F8FF" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Ray" StartPoint="100%,0%" EndPoint="15%,100%">
                <GradientStop Color="#58FFFFFF" Offset="0" />
                <GradientStop Color="#18FFFFFF" Offset="0.55" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Gloss" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#30FFFFFF" Offset="0" />
                <GradientStop Color="#0CFFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Ribbon" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#A8FFFFFF" Offset="0.45" />
                <GradientStop Color="#58E6FBFF" Offset="0.75" />
                <GradientStop Color="#00E6FBFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Ribbon.Aqua" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#0030D6F6" Offset="0" />
                <GradientStop Color="#B030D6F6" Offset="0.5" />
                <GradientStop Color="#0030D6F6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Ribbon.Mint" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#0046EAD2" Offset="0" />
                <GradientStop Color="#9046EAD2" Offset="0.55" />
                <GradientStop Color="#0046EAD2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Ground" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#48FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.Bubble" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#0AFFFFFF" Offset="0" />
                <GradientStop Color="#16FFFFFF" Offset="0.7" />
                <GradientStop Color="#58FFFFFF" Offset="0.88" />
                <GradientStop Color="#B0FFFFFF" Offset="0.97" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.Bubble.Spot" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#F0FFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.Bokeh" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#78FFFFFF" Offset="0" />
                <GradientStop Color="#30E8F8FF" Offset="0.5" />
                <GradientStop Color="#00E8F8FF" Offset="1" />
            </RadialGradientBrush>
            <!-- Floral art: glossy petals in the accent hue, frosted leaves, white vines. -->
            <RadialGradientBrush x:Key="Aero.Art.Petal" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#F0DDF2FF" Offset="0.3" />
                <GradientStop Color="#E87FC4F8" Offset="0.75" />
                <GradientStop Color="#E83D92E4" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Petal.Gloss" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#A0FFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.Petal.Core" Center="40%,35%" GradientOrigin="40%,35%" RadiusX="60%" RadiusY="60%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#CFEFFF" Offset="0.5" />
                <GradientStop Color="#5AB0F0" Offset="1" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="Aero.Art.Petal.Edge" Color="#B0FFFFFF" />
            <LinearGradientBrush x:Key="Aero.Art.Leaf" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#D0FFFFFF" Offset="0" />
                <GradientStop Color="#60E0F4FF" Offset="0.5" />
                <GradientStop Color="#18B0E0FF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Leaf.Deep" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#C02A78D0" Offset="0" />
                <GradientStop Color="#600F4C9C" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Aero.Art.Leaf.Edge" Color="#A0FFFFFF" />
            <SolidColorBrush x:Key="Aero.Art.Vine" Color="#C8FFFFFF" />
            <RadialGradientBrush x:Key="Aero.Art.Backdrop.Petal" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#1070B8F0" Offset="0" />
                <GradientStop Color="#4C70B8F0" Offset="1" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="Aero.Art.Backdrop.Leaf" Color="#2470B4EC" />
            <SolidColorBrush x:Key="Aero.Art.Backdrop.Vine" Color="#5C6CB0E8" />
            <SolidColorBrush x:Key="Aero.Art.Sparkle" Color="#F0FFFFFF" />
            <!-- The backdrop behind the hotkey gadget of the empty main window: a pale sky with the same ribbons. -->
            <LinearGradientBrush x:Key="Aero.Art.Backdrop" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#F4FAFF" Offset="0.5" />
                <GradientStop Color="#D9EFFD" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Backdrop.Ribbon" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#0058B4F0" Offset="0" />
                <GradientStop Color="#6058B4F0" Offset="0.5" />
                <GradientStop Color="#0058B4F0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.Art.Backdrop.Ribbon.Light" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#E0FFFFFF" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.Backdrop.Bubble" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#1078C8F4" Offset="0" />
                <GradientStop Color="#1E78C8F4" Offset="0.72" />
                <GradientStop Color="#6078C8F4" Offset="0.92" />
                <GradientStop Color="#0078C8F4" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Aero.Art.Backdrop.Glow" Center="0%,0%" GradientOrigin="0%,0%" RadiusX="60%" RadiusY="60%">
                <GradientStop Color="#40A8DCFF" Offset="0" />
                <GradientStop Color="#00A8DCFF" Offset="1" />
            </RadialGradientBrush>
        </ResourceDictionary>

        <!-- Aero Basic: the Aero controls with the opaque frame that AeroWindowFrame draws when there is no glass. -->
        <ResourceDictionary x:Key="{x:Static helpers:ThemeManager.ShareXAeroBasic}" />

        <!--
            Aero Dark: the same controls in smoky graphite glass, with luminous aqua highlights. Every Aero key has a dark
            value here; the blue and aqua hues are re-hued by the accent color like the Aero ones.
        -->
        <ResourceDictionary x:Key="{x:Static helpers:ThemeManager.ShareXAeroDark}">
            <x:Double x:Key="ShareX.FontSize.Default">12</x:Double>
            <Color x:Key="ShareX.Color.Accent.Start">#3399FF</Color>
            <Color x:Key="ShareX.Color.Accent.End">#3399FF</Color>
            <Color x:Key="ShareX.Color.Accent.Foreground">#FFFFFF</Color>
            <Color x:Key="ShareX.Color.Link">#7CC4FF</Color>

            <Color x:Key="ShareX.Color.Text">#F2F4F7</Color>
            <Color x:Key="ShareX.Color.Text.Secondary">#C4CAD2</Color>
            <Color x:Key="ShareX.Color.Status.Success">#5BD07A</Color>
            <Color x:Key="ShareX.Color.Status.Error">#FF7A7A</Color>

            <Color x:Key="ShareX.Color.Background.Main">#15181C</Color>
            <Color x:Key="ShareX.Color.Background.Panel">#1B1F24</Color>
            <Color x:Key="ShareX.Color.Background.Popup">#1E2228</Color>
            <Color x:Key="ShareX.Color.Background.Menu">#1E2228</Color>
            <Color x:Key="ShareX.Color.Background.Toolbar">#191D22</Color>

            <Color x:Key="ShareX.Color.Border">#323941</Color>
            <Color x:Key="ShareX.Color.Control.Background">#272C33</Color>
            <Color x:Key="ShareX.Color.Control.Background.Hover">#1F3549</Color>
            <Color x:Key="ShareX.Color.Control.Border">#4A525C</Color>
            <Color x:Key="ShareX.Color.Separator">#2E343B</Color>
            <Color x:Key="ShareX.Color.TaskMode.Cancel.Background">#DC2626</Color>
            <Color x:Key="ShareX.Color.TaskMode.Cancel.Border">#EF4444</Color>
            <Color x:Key="ShareX.Color.TaskMode.Continue.Background">#10B981</Color>
            <Color x:Key="ShareX.Color.TaskMode.Continue.Border">#13DD9A</Color>
            <Color x:Key="ShareX.Color.TaskMode.Foreground">#FFFFFF</Color>

            <SolidColorBrush x:Key="ShareX.Brush.Accent" Color="{StaticResource ShareX.Color.Accent.Start}" />
            <SolidColorBrush x:Key="ShareX.Brush.Accent.Start" Color="{StaticResource ShareX.Color.Accent.Start}" />
            <SolidColorBrush x:Key="ShareX.Brush.Accent.Foreground" Color="{StaticResource ShareX.Color.Accent.Foreground}" />
            <SolidColorBrush x:Key="ShareX.Brush.Link" Color="{StaticResource ShareX.Color.Link}" />

            <SolidColorBrush x:Key="ShareX.Brush.Text" Color="{StaticResource ShareX.Color.Text}" />
            <SolidColorBrush x:Key="ShareX.Brush.Text.Secondary" Color="{StaticResource ShareX.Color.Text.Secondary}" />
            <SolidColorBrush x:Key="ShareX.Brush.Status.Success" Color="{StaticResource ShareX.Color.Status.Success}" />
            <SolidColorBrush x:Key="ShareX.Brush.Status.Error" Color="{StaticResource ShareX.Color.Status.Error}" />

            <SolidColorBrush x:Key="ShareX.Brush.Background.Main" Color="{StaticResource ShareX.Color.Background.Main}" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Panel" Color="{StaticResource ShareX.Color.Background.Panel}" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Popup" Color="{StaticResource ShareX.Color.Background.Popup}" />
            <SolidColorBrush x:Key="ShareX.Brush.Background.Menu" Color="{StaticResource ShareX.Color.Background.Menu}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource ShareX.Color.Background.Menu}" />
            <LinearGradientBrush x:Key="ShareX.Brush.Background.Toolbar" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#222A33" Offset="0" />
                <GradientStop Color="#1B2027" Offset="0.4" />
                <GradientStop Color="#151A20" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="ShareX.Brush.Border" Color="{StaticResource ShareX.Color.Border}" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Background" Color="{StaticResource ShareX.Color.Control.Background}" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Background.Hover" Color="{StaticResource ShareX.Color.Control.Background.Hover}" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Border" Color="{StaticResource ShareX.Color.Control.Border}" />
            <SolidColorBrush x:Key="ShareX.Brush.Control.Background.Disabled" Color="#22262B" />
            <SolidColorBrush x:Key="ShareX.Brush.Separator" Color="{StaticResource ShareX.Color.Separator}" />
            <SolidColorBrush x:Key="ShareX.Brush.TaskMode.Cancel.Background" Color="{StaticResource ShareX.Color.TaskMode.Cancel.Background}" />
            <SolidColorBrush x:Key="ShareX.Brush.TaskMode.Cancel.Border" Color="{StaticResource ShareX.Color.TaskMode.Cancel.Border}" />
            <SolidColorBrush x:Key="ShareX.Brush.TaskMode.Continue.Background" Color="{StaticResource ShareX.Color.TaskMode.Continue.Background}" />
            <SolidColorBrush x:Key="ShareX.Brush.TaskMode.Continue.Border" Color="{StaticResource ShareX.Color.TaskMode.Continue.Border}" />
            <SolidColorBrush x:Key="ShareX.Brush.TaskMode.Foreground" Color="{StaticResource ShareX.Color.TaskMode.Foreground}" />
            <SolidColorBrush x:Key="ShareX.Brush.Overlay.Soft" Color="#40000000" />
            <SolidColorBrush x:Key="ShareX.Brush.Overlay.Modal" Color="#A0000000" />

            <DrawingBrush x:Key="ShareX.Brush.Checkered" TileMode="Tile" SourceRect="0,0,30,30" DestinationRect="0,0,30,30">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#22262B">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,30,30" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#2A2F35">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,15,15" />
                                    <RectangleGeometry Rect="15,15,15,15" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <DrawingBrush x:Key="ShareX.Brush.Checkered.Small" TileMode="Tile" SourceRect="0,0,8,8" DestinationRect="0,0,8,8">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#22262B">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,8,8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#2A2F35">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,4,4" />
                                    <RectangleGeometry Rect="4,4,4,4" />
