            <LinearGradientBrush x:Key="Aero.CaptionClose.Hot" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F6B3A2" Offset="0" />
                <GradientStop Color="#F08D7A" Offset="0.5" />
                <GradientStop Color="#E8553C" Offset="0.5" />
                <GradientStop Color="#F79478" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Aero.CaptionClose.Pressed" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#D08A7A" Offset="0" />
                <GradientStop Color="#C0533F" Offset="0.5" />
                <GradientStop Color="#A8301C" Offset="0.5" />
                <GradientStop Color="#B8321F" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Aero.CaptionClose.Border" Color="#B0601408" />
            <RadialGradientBrush x:Key="Aero.CaptionClose.Glow" Center="50%,60%" GradientOrigin="50%,60%" RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#C0FF5A30" Offset="0" />
                <GradientStop Color="#60FF4A2E" Offset="0.55" />
                <GradientStop Color="#00FF4A2E" Offset="1" />
            </RadialGradientBrush>

            <!-- Tab strip of the color view (Avalonia.Controls.ColorPicker) -->
            <SolidColorBrush x:Key="ColorViewTabBackgroundBrush" Color="#F0F0F0" />
            <CornerRadius x:Key="ColorViewTabBackgroundCornerRadius">3</CornerRadius>
            <!-- Height of the start screen drop-downs, which the accent color picker matches. -->
            <x:Double x:Key="Classic.OptionControl.Height">30</x:Double>
        </ResourceDictionary>

        <!-- Aero Basic: the Aero controls with the opaque frame that AeroWindowFrame draws when there is no glass. -->
        <ResourceDictionary x:Key="{x:Static helpers:ThemeManager.ShareXAeroBasic}" />

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
