            <SolidColorBrush x:Key="Classic.Button.Border" Color="#1F1F1F" />
            <SolidColorBrush x:Key="Classic.Button.Text" Color="#E7E9EA" />
            <SolidColorBrush x:Key="Classic.Button.Face.Hot" Color="#383838" />
            <SolidColorBrush x:Key="Classic.Button.Border.Hot" Color="#1F1F1F" />
            <SolidColorBrush x:Key="Classic.Button.Face.Pressed" Color="#222222" />
            <SolidColorBrush x:Key="Classic.Button.Border.Pressed" Color="#1F1F1F" />
            <SolidColorBrush x:Key="Classic.Button.Face.Disabled" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.Button.Border.Disabled" Color="#1F1F1F" />
            <SolidColorBrush x:Key="Classic.Button.Text.Disabled" Color="#6D6D6D" />
            <SolidColorBrush x:Key="Classic.Button.Border.Focus" Color="#1F1F1F" />
            <SolidColorBrush x:Key="Classic.Button.FocusRing" Color="Transparent" />
            <SolidColorBrush x:Key="Classic.Edit.Background" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.Edit.Background.Disabled" Color="#272727" />
            <SolidColorBrush x:Key="Classic.Edit.Text" Color="#E7E9EA" />
            <SolidColorBrush x:Key="Classic.Edit.Border" Color="#646464" />
            <SolidColorBrush x:Key="Classic.Edit.Border.Hot" Color="#646464" />
            <SolidColorBrush x:Key="Classic.Edit.Border.Focus" Color="#646464" />
            <SolidColorBrush x:Key="Classic.Edit.Border.Disabled" Color="#3F3F3F" />
            <SolidColorBrush x:Key="Classic.Combo.Face" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.Combo.Border" Color="#505050" />
            <SolidColorBrush x:Key="Classic.Combo.Face.Hot" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.Combo.Border.Hot" Color="#646464" />
            <SolidColorBrush x:Key="Classic.Combo.Face.Pressed" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.Combo.Border.Pressed" Color="#646464" />
            <SolidColorBrush x:Key="Classic.Combo.Text" Color="#E7E9EA" />
            <SolidColorBrush x:Key="Classic.Combo.Button" Color="#383838" />
            <SolidColorBrush x:Key="Classic.Combo.Button.Border" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.Combo.Glyph" Color="#C8C8C8" />
            <SolidColorBrush x:Key="Classic.List.Background" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.List.Text" Color="#E7E9EA" />
            <SolidColorBrush x:Key="Classic.List.Border" Color="#828790" />
            <SolidColorBrush x:Key="Classic.DropDown.Background" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.DropDown.Border" Color="#646464" />
            <SolidColorBrush x:Key="Classic.Tree.Background" Color="#222222" />
            <SolidColorBrush x:Key="Classic.Menu.Background" Color="#272727" />
            <SolidColorBrush x:Key="Classic.Menu.Border" Color="#3F3F3F" />
            <SolidColorBrush x:Key="Classic.Menu.Text" Color="#E7E9EA" />
            <SolidColorBrush x:Key="Classic.Menu.Selected" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.Menu.Selected.Border" Color="#3F3F3F" />
            <SolidColorBrush x:Key="Classic.Menu.Pressed" Color="#2E2E2E" />
            <SolidColorBrush x:Key="Classic.Menu.Checked" Color="#333333" />
            <SolidColorBrush x:Key="Classic.Menu.Separator.Dark" Color="#1F1F1F" />
            <SolidColorBrush x:Key="Classic.Menu.Separator.Light" Color="#2C2C2C" />
            <SolidColorBrush x:Key="Classic.Menu.ImageMargin" Color="#272727" />
            <!-- Tab strip of the color view (Avalonia.Controls.ColorPicker), flat like a button face. -->
            <SolidColorBrush x:Key="ColorViewTabBackgroundBrush" Color="#2E2E2E" />
            <CornerRadius x:Key="ColorViewTabBackgroundCornerRadius">0</CornerRadius>
            <!-- Height of the start screen drop-downs, which the accent color picker matches. -->
            <x:Double x:Key="Classic.OptionControl.Height">38</x:Double>
            <!-- ShareXTheme.MenuFont (Segoe UI 9.75pt); the flat combo box draws a filled arrow. -->
            <x:Double x:Key="Classic.Menu.FontSize">13</x:Double>
            <x:Boolean x:Key="Classic.Combo.Chevron">False</x:Boolean>
            <x:Boolean x:Key="Classic.Combo.Triangle">True</x:Boolean>
