            <Color x:Key="ShareX.Color.Status.Success">#79B58A</Color>
            <Color x:Key="ShareX.Color.Status.Error">#D07C7C</Color>

            <Color x:Key="ShareX.Color.Background.Main">#272727</Color>
            <Color x:Key="ShareX.Color.Background.Panel">#272727</Color>
            <Color x:Key="ShareX.Color.Background.Popup">#2E2E2E</Color>
            <Color x:Key="ShareX.Color.Background.Menu">#272727</Color>
            <Color x:Key="ShareX.Color.Background.Toolbar">#272727</Color>

            <Color x:Key="ShareX.Color.Border">#1F1F1F</Color>
            <Color x:Key="ShareX.Color.Control.Background">#2E2E2E</Color>
            <Color x:Key="ShareX.Color.Control.Background.Hover">#383838</Color>
            <Color x:Key="ShareX.Color.Control.Border">#1F1F1F</Color>
