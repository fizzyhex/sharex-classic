            <SolidColorBrush x:Key="Classic.Spin.Border.Pressed" Color="#005499" />
            <SolidColorBrush x:Key="Classic.Progress.Track" Color="#222222" />
            <SolidColorBrush x:Key="Classic.Progress.Border" Color="#3F3F3F" />
            <SolidColorBrush x:Key="Classic.Progress.Fill" Color="#06B025" />
            <SolidColorBrush x:Key="Classic.Progress.Text" Color="#E7E9EA" />
            <SolidColorBrush x:Key="Classic.TrackBar.Track" Color="#222222" />
            <SolidColorBrush x:Key="Classic.TrackBar.Track.Border" Color="#3F3F3F" />
            <SolidColorBrush x:Key="Classic.TrackBar.Thumb" Color="#007AD9" />
            <SolidColorBrush x:Key="Classic.TrackBar.Thumb.Hot" Color="#E7E9EA" />
